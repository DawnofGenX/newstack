{
  "name": "python-graphql-api",
  "title": "Python GraphQL API",
  "language": "python",
  "blurb": "graphql-core schema on stdlib http.server: arguments, resolver errors with paths, aliases, variables, POST /graphql and GET /health",
  "default_description": "A GraphQL API built on graphql-core and stdlib http.server.",
  "requires": [
    "uv",
    "curl"
  ],
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "port": 5530,
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install -e . pytest ruff",
    "PORT=8080 .venv/bin/python -m {{ package_name }}"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": [
        "uv",
        "curl"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "pyproject.toml",
      "contains": "graphql-core"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_schema.py"
  ]
}