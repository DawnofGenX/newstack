{
  "name": "node-ttl-cache",
  "title": "Node TTL Cache",
  "language": "node",
  "blurb": "TTL + LRU cache with hit/miss/eviction counters, driven by a command stream.",
  "requires": [
    "node",
    "npm"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A TTL and LRU cache with counters, exercised by a scriptable command stream.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "printf 'SET a 1\\nSET b 2 50\\nGET a\\nADVANCE 50\\nGET b\\nSTATS\\n' | node src/cli.js"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "src/cache.js",
      "contains": "export function createCache"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/cache.test.js"
  ]
}
