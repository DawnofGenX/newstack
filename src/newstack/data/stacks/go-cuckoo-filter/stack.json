{
  "name": "go-cuckoo-filter",
  "title": "Go Cuckoo Filter",
  "language": "go",
  "blurb": "Cuckoo filter with 16 bit fingerprints: insert, lookup, delete, eviction on load, JSON CLI.",
  "requires": [
    "go",
    "git"
  ],
  "default_description": "A cuckoo filter with insert, lookup and delete over string keys.",
  "next_steps": [
    "cd {path}",
    "go build -o bin/app .",
    "./bin/app -add alpha,beta -has beta"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": [
        "go"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/{{ npm_name }} .",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "cuckoo.go",
      "contains": "type Filter struct"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "cuckoo_test.go"
  ]
}
