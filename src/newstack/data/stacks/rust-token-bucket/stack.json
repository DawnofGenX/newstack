{
  "name": "rust-token-bucket",
  "title": "Rust Token Bucket",
  "language": "rust",
  "blurb": "Token bucket limiter with injectable ms clock: burst, fractional refill, acquire_n, time_until.",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A token bucket rate limiter with a deterministic clock.",
  "next_steps": [
    "cd {path}",
    "cargo run -- --capacity 5 --rate 2 --requests 8 --interval-ms 400"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "src/lib.rs",
      "contains": "pub struct TokenBucket"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/token_bucket.rs"
  ]
}
