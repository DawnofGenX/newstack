{
  "name": "go-semver-cli",
  "title": "Go Semver CLI",
  "language": "go",
  "blurb": "Semantic version parse/compare/satisfies with prerelease ordering, caret, tilde and x-ranges.",
  "requires": [
    "go",
    "git"
  ],
  "default_description": "A semantic version comparison and constraint CLI.",
  "next_steps": [
    "cd {path}",
    "go build -o bin/app .",
    "./bin/app satisfies 1.9.0 '^1.2.0'"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": [
        "go"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/{{ npm_name }} .",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "semver.go",
      "contains": "func Satisfies"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "semver_test.go"
  ]
}
