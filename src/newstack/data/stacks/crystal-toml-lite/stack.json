{
  "name": "crystal-toml-lite",
  "title": "Crystal TOML Lite",
  "language": "crystal",
  "blurb": "Crystal TOML subset parser with flattened output.",
  "requires": [
    "crystal"
  ],
  "default_description": "A Crystal TOML parser.",
  "next_steps": [
    "cd {path}",
    "crystal spec",
    "crystal build -o bin/{{ npm_name }} src/main.cr",
    "./bin/{{ npm_name }} --help"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "crystal spec",
      "tools": [
        "crystal"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "mkdir -p bin && crystal build -o bin/{{ npm_name }} src/main.cr",
      "tools": [
        "crystal"
      ],
      "timeout": 600
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} does-not-exist.toml >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    },
    {
      "name": "flatten",
      "cmd": "printf 'name = \"demo\"\\n[server]\\nport = 8080\\n' > /tmp/c.toml && ./bin/{{ npm_name }} /tmp/c.toml | grep -q 'server.port = 8080'",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "src/toml_lite.cr",
      "contains": "module TomlLite"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
