{
  "name": "go-bloom-filter",
  "title": "Go Bloom Filter",
  "language": "go",
  "blurb": "Bloom filter library plus CLI (add, check, stats), fixed-size bit array, double hashing FNV-64a",
  "requires": ["go", "git"],
  "default_description": "A bloom filter library and CLI.",
  "next_steps": [
    "cd {path}",
    "go test ./...",
    "go build -o bin/bloom ."
  ],
  "verify": [
    { "name": "vet", "cmd": "go vet ./...", "tools": ["go"], "timeout": 300 },
    { "name": "test", "cmd": "go test ./...", "tools": ["go"], "timeout": 600 },
    { "name": "build", "cmd": "go build -o bin/bloom .", "tools": ["go"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash"], "timeout": 300 }
  ],
  "detect": [{ "file": "bloom.go", "contains": "NewBloom" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["bloom_test.go"]
}
