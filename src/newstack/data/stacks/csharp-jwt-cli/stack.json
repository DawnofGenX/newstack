{
  "name": "csharp-jwt-cli",
  "title": "CSharp JWT CLI",
  "language": "csharp",
  "blurb": "JWT encode/decode/verify CLI on HMAC-SHA256 with xunit tests, .NET 8",
  "requires": [
    "dotnet",
    "git"
  ],
  "default_description": "A C# JWT command line tool.",
  "next_steps": [
    "cd {path}",
    "dotnet build",
    "dotnet run -- encode sub=alice --secret s3cr3t"
  ],
  "verify": [
    {
      "name": "build",
      "cmd": "dotnet build --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "test",
      "cmd": "dotnet test tests/*.csproj --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "dotnet"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "Program.cs",
      "contains": "csharp-jwt-cli"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/JwtTests.cs"
  ]
}