{
  "name": "kotlin-cli",
  "title": "Kotlin CLI",
  "language": "kotlin",
  "blurb": "Kotlin/JVM 21 CLI on Maven: pure counting core, hand-rolled args, JUnit 5 suite, runnable jar",
  "requires": [
    "java",
    "mvn"
  ],
  "default_description": "A Kotlin command line tool.",
  "next_steps": [
    "cd {path}",
    "mvn -B package",
    "java -jar target/{npm_name}.jar --help"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "mvn -B verify",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "help",
      "cmd": "java -jar target/{{ npm_name }}.jar --help",
      "tools": [
        "java"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "java -jar target/{{ npm_name }}.jar --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "java"
      ],
      "timeout": 120
    },
    {
      "name": "missing-file",
      "cmd": "java -jar target/{{ npm_name }}.jar does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "java"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "pom.xml",
      "contains": "kotlin"
    }
  ],
  "detect_fallback": true,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
