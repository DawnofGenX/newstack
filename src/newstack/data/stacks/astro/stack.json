{
  "name": "astro",
  "title": "Astro + TypeScript",
  "language": "node",
  "blurb": "Static content site with a typed page, Vitest unit tests, astro check, CI",
  "requires": [
    "node",
    "npm",
    "git"
  ],
  "node": {
    "minimum": "24",
    "versions": [
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A static content site built with Astro.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_run} dev"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "typecheck",
      "cmd": "npm run typecheck",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "npm run build",
      "tools": [
        "npm"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "package.json",
      "contains": "\"astro\""
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore",
    "tsconfig.json",
    "astro.config.mjs"
  ],
  "adopt_tests": [
    "src/lib/content.test.ts"
  ]
}
