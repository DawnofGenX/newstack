{
  "name": "tcl-json-query-cli",
  "title": "Tcl JSON Query CLI",
  "language": "tcl",
  "blurb": "Tcl CLI: query a JSON document by path (a.b[0].c), stdlib only",
  "requires": [
    "tclsh"
  ],
  "default_description": "A Tcl command line tool.",
  "next_steps": [
    "cd {path}",
    "tclsh tests/run.tcl",
    "./bin/{npm_name} --help"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "tclsh tests/run.tcl",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} a.b /dev/null 2>&1; test $? -ne 0 || true",
      "tools": [
        "tclsh"
      ],
      "timeout": 120
    },
    {
      "name": "stdin",
      "cmd": "printf '{\"a\":{\"b\":[1,2]}}' | ./bin/{{ npm_name }} a.b[1]",
      "tools": [
        "tclsh"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "lib/query.tcl",
      "contains": "tcl-json-query-cli"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}