{
  "name": "fastapi",
  "title": "FastAPI service",
  "language": "python",
  "blurb": "Typed JSON API: pydantic models, TestClient tests, Dockerfile",
  "requires": [
    "uv",
    "git"
  ],
  "python": {
    "minimum": "3.10",
    "versions": ["3.10", "3.11", "3.12", "3.13"]
  },
  "default_description": "A FastAPI service.",
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run uvicorn {package_name}.main:app --reload"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv -q .venv && uv pip install -q --python .venv/bin/python -e . pytest httpx ruff",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "pyproject.toml",
      "contains": "fastapi"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore",
    "Dockerfile"
  ],
  "adopt_tests": [
    "tests/test_api.py"
  ]
}
