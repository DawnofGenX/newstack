{
  "name": "java-template-engine",
  "title": "Java Template Engine",
  "language": "java",
  "blurb": "Regex {{ key }} template renderer CLI with JUnit tests, Maven compiler release 21",
  "requires": [
    "java",
    "mvn",
    "git"
  ],
  "default_description": "A Java template engine CLI.",
  "next_steps": [
    "cd {path}",
    "mvn -B package",
    "java -jar target/{{ npm_name }}.jar template.txt name=World"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "mvn -B test",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "package",
      "cmd": "mvn -B package -DskipTests",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "java",
        "mvn"
      ],
      "timeout": 1800
    }
  ],
  "detect": [
    {
      "file": "src/main/java/{{ package_name }}/TemplateEngine.java",
      "contains": "java-template-engine"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "src/test/java/{{ package_name }}/TemplateEngineTest.java"
  ]
}