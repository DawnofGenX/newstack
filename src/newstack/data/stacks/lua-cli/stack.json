{
  "name": "lua-cli",
  "title": "Lua CLI",
  "language": "lua",
  "blurb": "Lua 5.4 CLI that counts lines, words and bytes: pure counting module, hand-written option parser, dependency-free spec runner",
  "requires": [
    "lua5.4"
  ],
  "default_description": "A Lua command line tool.",
  "next_steps": [
    "cd {path}",
    "./bin/{npm_name} --help",
    "./bin/{npm_name} README.md",
    "lua5.4 spec/run.lua"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "lua5.4 spec/run.lua",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": ".luarc.json",
      "contains": "Lua 5.4"
    }
  ],
  "detect_fallback": true,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore",
    ".luarc.json"
  ],
  "adopt_tests": []
}
