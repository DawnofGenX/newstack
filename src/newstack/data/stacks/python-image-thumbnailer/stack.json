{
  "name": "python-image-thumbnailer",
  "title": "Image Thumbnailer",
  "language": "python",
  "blurb": "Pillow thumbnails: EXIF orientation, aspect-preserving max box, JPEG quality, RGBA/palette, batch with per-file errors",
  "default_description": "A CLI that makes thumbnails.",
  "requires": [
    "uv"
  ],
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install -e . pytest",
    ".venv/bin/python -m {package_name} thumbnail ./photo.jpg ./out.jpg --size 256x256"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest pillow ruff",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "exif_transpose"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_thumbnail.py"
  ]
}
