{
  "name": "{{ npm_name }}",
  "version": "0.1.0",
  "exports": "./src/handler.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/http": "jsr:@std/http@^1.0.0"
  },
  "tasks": {
    "check": "deno check src/handler.ts src/server.ts",
    "test": "deno test --allow-env --allow-net",
    "fmt": "deno fmt --check src test",
    "lint": "deno lint src test",
    "start": "deno run --allow-env --allow-net src/server.ts"
  }
}
