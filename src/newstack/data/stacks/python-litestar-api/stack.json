{
  "name": "python-litestar-api",
  "title": "Litestar text-statistics API",
  "language": "python",
  "blurb": "HTTP API: Litestar 2, one catch-all route, validation read by hand so 422 is yours, TestClient tests, live curl contract",
  "default_description": "A Litestar API.",
  "requires": [
    "uv",
    "curl"
  ],
  "python": {
    "minimum": "3.12",
    "versions": [
      "3.12",
      "3.13"
    ]
  },
  "port": 5464,
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing && uv pip install -e . pytest httpx ruff",
    "PORT=8080 .venv/bin/python -m {package_name}"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest httpx ruff",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": [
        "uv",
        "curl"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "from litestar"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_app.py"
  ]
}
