{
  "name": "tcl-base64-cli",
  "title": "Tcl Base64 CLI",
  "language": "tcl",
  "blurb": "Base64 and base64url in plain tclsh: byte-string codec, strict padding checks, hex mode, hand-written argv parser",
  "requires": [
    "tclsh"
  ],
  "default_description": "A Tcl command line tool that encodes and decodes base64.",
  "next_steps": [
    "cd {path}",
    "tclsh tests/run.tcl",
    "./bin/{npm_name} encode -t foobar"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "tclsh tests/run.tcl",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    },
    {
      "name": "encode",
      "cmd": "test \"$(./bin/{{ npm_name }} encode -t foobar)\" = 'Zm9vYmFy'",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    },
    {
      "name": "decode",
      "cmd": "test \"$(./bin/{{ npm_name }} decode -t Zm9vYmFy)\" = 'foobar'",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    },
    {
      "name": "stdin",
      "cmd": "test \"$(printf 'hello' | ./bin/{{ npm_name }} encode)\" = 'aGVsbG8='",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} frobnicate >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    },
    {
      "name": "invalid-input",
      "cmd": "./bin/{{ npm_name }} decode -t 'not base64!!' >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "tclsh"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "lib/base64.tcl",
      "contains": "namespace eval ::b64"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
