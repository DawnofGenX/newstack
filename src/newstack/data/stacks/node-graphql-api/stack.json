{
  "name": "node-graphql-api",
  "title": "Node GraphQL API",
  "language": "node",
  "blurb": "GraphQL server with graphql + graphql-yoga: schema with Query.notes / Mutation.addNote, in-memory store, node --test resolvers, live curl",
  "requires": [
    "node",
    "npm",
    "curl"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A GraphQL API built with graphql-yoga.",
  "port": 5551,
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "PORT=8080 {package_manager_run} start",
    "curl -sS -X POST http://127.0.0.1:8080/graphql -H 'content-type: application/json' -d '{{\"query\":\"{{ notes {{ id title }} }}\"}}'"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node",
        "curl"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "src/main.js",
      "contains": "graphql-yoga"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/resolvers.test.js"
  ]
}