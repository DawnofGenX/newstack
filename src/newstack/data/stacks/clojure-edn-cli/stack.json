{
  "name": "clojure-edn-cli",
  "title": "Clojure EDN CLI",
  "language": "clojure",
  "blurb": "Parse, pretty-print, and query EDN documents from the command line using only clojure.edn",
  "requires": [
    "clojure",
    "java"
  ],
  "default_description": "A Clojure command line tool for EDN.",
  "next_steps": [
    "cd {path}",
    "clojure -M -e \"(require 'edncli.cli)\"",
    "clojure -M:test -m edncli.run-tests",
    "./bin/{npm_name} --help"
  ],
  "verify": [
    {
      "name": "compile",
      "cmd": "clojure -M -e \"(require 'edncli.cli)\"",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 1800
    },
    {
      "name": "test",
      "cmd": "clojure -M:test -m edncli.run-tests",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 1800
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} frobnicate >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} pretty nope.edn >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "deps.edn",
      "contains": "stack: clojure-edn-cli"
    }
  ],
  "detect_fallback": true,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}