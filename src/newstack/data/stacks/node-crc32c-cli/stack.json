{
  "name": "node-crc32c-cli",
  "title": "Node CRC32C CLI",
  "language": "node",
  "blurb": "CRC-32C (Castagnoli) checksum CLI with a pure-JS implementation, pinned test vectors, stdin or file input.",
  "requires": ["node", "npm"],
  "node": { "minimum": "22", "versions": ["22", "24"] },
  "package_manager": ["npm", "pnpm", "yarn"],
  "default_description": "A Node CLI that computes CRC-32C checksums.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js README.md"
  ],
  "verify": [
    { "name": "install", "cmd": "npm install --no-audit --no-fund", "tools": ["npm"], "timeout": 900 },
    { "name": "test", "cmd": "npm test", "tools": ["npm"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "node"], "timeout": 300 }
  ],
  "detect": [{ "file": "src/crc.js", "contains": "export function crc32c" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/crc.test.js"]
}