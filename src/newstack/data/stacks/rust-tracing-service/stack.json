{
  "name": "rust-tracing-service",
  "title": "Rust Tracing Service",
  "language": "rust",
  "blurb": "tracing + tracing-subscriber JSON output with a small HTTP service",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A small Rust service with structured JSON logs.",
  "port": 5514,
  "next_steps": [
    "cd {path}",
    "cargo run",
    "curl -sS http://127.0.0.1:5514/health"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo",
        "curl"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "Cargo.toml",
      "contains": "tracing"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/api.rs"
  ]
}