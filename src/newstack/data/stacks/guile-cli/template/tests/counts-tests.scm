(define-module (counts-tests)
  #:use-module (rnrs bytevectors)
  #:use-module (harness)
  #:use-module (textstat counts)
  #:export (run-suite))

(define (tally text)
  (counts-of-bytevector (string->utf8 text)))

(define (run-suite)
  (let ((empty (tally ""))
        (plain (tally "alpha beta\ngamma delta\n"))
        (no-newline (tally "alpha beta\ngamma"))
        (multi (tally "h\u00e9llo w\u00f6rld\n"))
        (control (tally "a\tb\u000bc\u000cd\n"))
        (only-spaces (tally " \t\n")))
    (check-equal "empty: lines" (counts-lines empty) 0)
    (check-equal "empty: words" (counts-words empty) 0)
    (check-equal "empty: bytes" (counts-bytes empty) 0)
    (check-equal "plain: lines" (counts-lines plain) 2)
    (check-equal "plain: words" (counts-words plain) 4)
    (check-equal "plain: bytes" (counts-bytes plain) 23)
    (check-equal "no trailing newline: lines" (counts-lines no-newline) 1)
    (check-equal "no trailing newline: words" (counts-words no-newline) 3)
    (check-equal "no trailing newline: bytes" (counts-bytes no-newline) 16)
    (check-equal "multibyte: lines" (counts-lines multi) 1)
    (check-equal "multibyte: words" (counts-words multi) 2)
    (check-equal "multibyte: bytes" (counts-bytes multi) 14)
    (check-equal "control: lines" (counts-lines control) 1)
    (check-equal "control: words" (counts-words control) 4)
    (check-equal "control: bytes" (counts-bytes control) 8)
    (check-equal "whitespace only: lines" (counts-lines only-spaces) 1)
    (check-equal "whitespace only: words" (counts-words only-spaces) 0)
    (check-equal "whitespace only: bytes" (counts-bytes only-spaces) 3)
    (let ((sum (counts-add plain plain)))
      (check-equal "add: lines" (counts-lines sum) 4)
      (check-equal "add: words" (counts-words sum) 8)
      (check-equal "add: bytes" (counts-bytes sum) 46))
    (check-equal "columns in wc order" (counts-columns '(lines words bytes) plain)
                '(2 4 23))
    (check-equal "columns honour the order asked" (counts-columns '(bytes lines) plain)
                '(23 2))
    (check-equal "figure width" (figure-width 12345) 5)))
