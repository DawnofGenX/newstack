{
  "name": "python-count-min",
  "title": "Count-Min Sketch",
  "language": "python",
  "blurb": "A count-min sketch over [0, 256): the min of rows never dips under the ledger truth on seeded streams, the audit runs after every update, and the shipped grid answers its corpora exactly.",
  "default_description": "A count-min sketch over [0, 256) whose min of rows never undercounts and audits after every update.",
  "requires": [
    "uv",
    "python3"
  ],
  "python": {
    "minimum": "3.12",
    "versions": [
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run {npm_name} count --stream fixtures/stream.txt 7",
    "uv run {npm_name} add --stream fixtures/stream.txt 7 2",
    "uv run {npm_name} report --stream fixtures/stream.txt",
    "PY=.venv/bin/python bash smoke.sh"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --python 3.12 --allow-existing && uv pip install --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "lint",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 120
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} selftest",
      "tools": [
        "uv"
      ],
      "timeout": 120
    },
    {
      "name": "smoke",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 180
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "the min of rows never dips under the truth"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".gitignore",
    ".github/workflows/ci.yml"
  ],
  "adopt_tests": [
    "tests/test_sketch.py"
  ]
}
