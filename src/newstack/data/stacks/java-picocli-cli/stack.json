{
  "name": "java-picocli-cli",
  "title": "Java Picocli CLI",
  "language": "java",
  "blurb": "picocli CLI on Maven with JUnit 5 tests and a shaded jar smoke",
  "requires": [
    "java",
    "mvn",
    "git"
  ],
  "default_description": "A Java command line tool built with picocli.",
  "next_steps": [
    "cd {path}",
    "mvn -B package",
    "java -jar target/{{ npm_name }}.jar --help"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "mvn -B verify",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "help",
      "cmd": "java -jar target/{{ npm_name }}.jar --help",
      "tools": [
        "java"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "java -jar target/{{ npm_name }}.jar --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "java"
      ],
      "timeout": 120
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "java",
        "mvn"
      ],
      "timeout": 1800
    }
  ],
  "detect": [
    {
      "file": "pom.xml",
      "contains": "picocli"
    }
  ],
  "detect_fallback": true,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "src/test/java/{{ package_name }}/CommandsTest.java"
  ]
}