{
  "name": "rust-axum-ws",
  "title": "Rust Axum WebSocket",
  "language": "rust",
  "blurb": "Rust axum 0.8 WebSocket echo/broadcast server (axum ws, tokio, futures-util): /health plus /ws, broadcast to all subscribers",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust axum WebSocket echo and broadcast server.",
  "next_steps": [
    "cd {path}",
    "cargo run",
    "",
    "curl http://127.0.0.1:5552/health"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "Cargo.toml",
      "contains": "features = [\"ws\"]"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/hub.rs"
  ]
}