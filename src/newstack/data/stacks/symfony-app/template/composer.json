{
    "name": "{{ npm_name }}/{{ npm_name }}",
    "description": "{{ description }}",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "{{ package_name }}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{ package_name }}\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
