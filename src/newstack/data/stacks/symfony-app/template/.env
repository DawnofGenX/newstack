# Default environment variables for the app.
#
# Override locally in .env.local (never committed). Real environment
# variables win over everything in this file.
#
# DO NOT commit real secrets. See https://symfony.com/doc/current/configuration/secrets.html

APP_ENV=dev
# Placeholder — replace with your own secret before deploying.
APP_SECRET=ChangeMeToYourOwnSecret
# Used to generate URLs in non-HTTP contexts, such as console commands.
DEFAULT_URI=http://localhost
