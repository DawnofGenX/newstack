{
  "name": "symfony-app",
  "title": "Symfony Web App",
  "language": "php",
  "blurb": "PHP 8.3 Symfony 7 web app on Composer: a JSON route, a pure service, and a PHPUnit 11 suite",
  "requires": [
    "php",
    "composer"
  ],
  "default_description": "A Symfony web application.",
  "next_steps": [
    "cd {path}",
    "composer install",
    "php bin/console about",
    "vendor/bin/phpunit"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "composer install --no-interaction --prefer-dist && vendor/bin/phpunit",
      "tools": [
        "composer",
        "php"
      ],
      "timeout": 1200
    },
    {
      "name": "console",
      "cmd": "php bin/console about",
      "tools": [
        "php"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "bin/console"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
