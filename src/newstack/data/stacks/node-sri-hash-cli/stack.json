{
  "name": "node-sri-hash-cli",
  "title": "Node SRI Hash",
  "language": "node",
  "blurb": "Subresource Integrity hashes and manifest verification: sha256/384/512, multi-token, per-file results.",
  "requires": [
    "node",
    "npm"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A Subresource Integrity hashing and verification CLI.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js hash public/app.js"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "src/sri.js",
      "contains": "sriFor"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/sri.test.js"
  ]
}
