{
  "name": "laravel-app",
  "title": "Laravel Web App",
  "language": "php",
  "blurb": "PHP 8.3 Laravel 13 JSON service on Composer: a pure counting class, one route and controller, and a PHPUnit 12 suite",
  "requires": [
    "php",
    "composer"
  ],
  "default_description": "A Laravel web application.",
  "next_steps": [
    "cd {path}",
    "composer install",
    "cp .env.example .env",
    "php artisan test"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "composer install --no-interaction --prefer-dist && cp .env.example .env && php artisan test",
      "tools": [
        "composer",
        "php"
      ],
      "timeout": 1200
    },
    {
      "name": "routes",
      "cmd": "php artisan route:list --except-vendor",
      "tools": [
        "php"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "artisan"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
