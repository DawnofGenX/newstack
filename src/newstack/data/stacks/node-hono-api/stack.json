{
  "name": "node-hono-api",
  "title": "Node Hono API",
  "language": "node",
  "blurb": "Hono HTTP JSON API (CRUD over in-memory store), typed routes, contract check via curl in smoke.sh.",
  "requires": ["node", "npm", "curl"],
  "node": {
    "minimum": "22",
    "versions": ["22", "24"]
  },
  "package_manager": ["npm", "pnpm", "yarn"],
  "default_description": "A Hono JSON API.",
  "port": 5560,
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "PORT=8080 {package_manager_run} start",
    "curl -sS http://127.0.0.1:8080/health"
  ],
  "verify": [
    { "name": "install", "cmd": "npm install --no-audit --no-fund", "tools": ["npm"], "timeout": 900 },
    { "name": "test", "cmd": "npm test", "tools": ["npm"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "node", "curl"], "timeout": 300 }
  ],
  "detect": [{ "file": "src/store.js", "contains": "in-memory store for node-hono-api" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/app.test.js"]
}