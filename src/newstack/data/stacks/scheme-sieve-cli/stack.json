{
  "name": "scheme-sieve-cli",
  "title": "Scheme Sieve CLI",
  "language": "scheme",
  "blurb": "Sieve of Eratosthenes, factorization, and a tiny expression evaluator (Guile).",
  "requires": ["guile"],
  "default_description": "A Guile Scheme command line tool.",
  "next_steps": [
    "cd {path}",
    "./bin/{npm_name} --help",
    "guile --no-auto-compile -L lib -L tests -s tests/run-tests.scm"
  ],
  "verify": [
    { "name": "test", "cmd": "guile --no-auto-compile -L lib -L tests -s tests/run-tests.scm", "tools": ["guile"], "timeout": 300 },
    { "name": "sieve", "cmd": "./bin/{{ npm_name }} sieve 10 | grep -q '2 3 5 7'", "tools": ["guile"], "timeout": 120 },
    { "name": "factor", "cmd": "./bin/{{ npm_name }} factor 12 | grep -q '2 2 3'", "tools": ["guile"], "timeout": 120 },
    { "name": "eval", "cmd": "test \"$(./bin/{{ npm_name }} eval '2 + 3 * 4')\" = '14'", "tools": ["guile"], "timeout": 120 },
    { "name": "help", "cmd": "./bin/{{ npm_name }} --help", "tools": ["guile"], "timeout": 120 },
    { "name": "usage-error", "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2", "tools": ["guile"], "timeout": 120 }
  ],
  "detect": [{ "file": "lib/sieve/primes.scm", "contains": "SCHEME_SIEVE_CLI_MARKER_4e8a2b" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": []
}