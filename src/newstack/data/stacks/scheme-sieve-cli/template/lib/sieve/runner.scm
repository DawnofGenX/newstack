(define-module (sieve runner)
  #:use-module (sieve primes)
  #:use-module (sieve eval)
  #:use-module (srfi srfi-13)
  #:export (run))

(define (run args io)
  ;; io is alist of procedures: read-file read-stdin write-line write-error
  (let ((read-file (car io))
        (read-stdin (cadr io))
        (write-line (caddr io))
        (write-error (cadddr io)))
    (cond
     ((null? args)
      (write-error "usage: sieve N | factor N | eval EXPR\n")
      2)
     ((string=? (car args) "--help")
      (write-line "Usage: scheme-sieve-cli sieve N")
      (write-line "       scheme-sieve-cli factor N")
      (write-line "       scheme-sieve-cli eval EXPR")
      0)
     ((string=? (car args) "sieve")
      (if (not (= (length args) 2))
          (begin (write-error "usage: sieve N\n") 2)
          (let ((n (string->number (cadr args))))
            (if (or (not n) (< n 0))
                (begin (write-error "invalid N\n") 1)
                (begin
                  (write-line (string-join (map number->string (primes-up-to n)) " "))
                  0)))))
     ((string=? (car args) "factor")
      (if (not (= (length args) 2))
          (begin (write-error "usage: factor N\n") 2)
          (let ((n (string->number (cadr args))))
            (if (or (not n) (< n 2))
                (begin (write-error "invalid N\n") 1)
                (begin
                  (write-line (string-join (map number->string (factorize n)) " "))
                  0)))))
     ((string=? (car args) "eval")
      (if (< (length args) 2)
          (begin (write-error "usage: eval EXPR\n") 2)
          (let* ((expr (string-join (cdr args) " "))
                 (v (catch #t
                      (lambda () (eval-expr expr))
                      (lambda (key . args) #f))))
            (if (not v)
                (begin (write-error "eval error\n") 1)
                (begin (write-line (number->string v)) 0)))))
     (else
      (write-error "unknown command\n")
      2))))