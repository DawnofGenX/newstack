;;; Sieve of Eratosthenes and factorization.
(define-module (sieve primes)
  #:export (primes-up-to factorize))

(define (primes-up-to n)
  (if (< n 2)
      '()
      (let ((sieve (make-vector (+ n 1) #t)))
        (vector-set! sieve 0 #f)
        (vector-set! sieve 1 #f)
        (let loop ((i 2))
          (when (<= i n)
            (when (vector-ref sieve i)
              (let mark ((j (* i i)))
                (when (<= j n)
                  (vector-set! sieve j #f)
                  (mark (+ j i)))))
            (loop (+ i 1))))
        (let collect ((i 2) (acc '()))
          (if (> i n)
              (reverse acc)
              (collect (+ i 1)
                       (if (vector-ref sieve i) (cons i acc) acc)))))))

(define (factorize n)
  (if (< n 2)
      '()
      (let loop ((n n) (d 2) (acc '()))
        (cond
         ((= n 1) (reverse acc))
         ((> (* d d) n) (reverse (cons n acc)))
         ((= (modulo n d) 0)
          (loop (/ n d) d (cons d acc)))
         (else (loop n (+ d 1) acc))))))