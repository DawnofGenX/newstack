{
  "name": "node-load-test",
  "title": "Node load test",
  "language": "node",
  "blurb": "HTTP load generator with honest percentiles: keep-alive client, warm-up window, nearest-rank p50/p95/p99 and thresholds that fail a build",
  "requires": [
    "node",
    "npm",
    "git"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A load test harness.",
  "port": 5471,
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_run} build",
    "{package_manager_run} stub",
    "node dist/src/main.js run --target http://127.0.0.1:5471/ok --requests 200 --concurrency 8 --threshold p95=250"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "typecheck",
      "cmd": "npm run typecheck",
      "tools": [
        "npm"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "selftest",
      "cmd": "npm run selftest",
      "tools": [
        "npm"
      ],
      "timeout": 300
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node",
        "curl",
        "ss"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "package.json",
      "contains": "nearest-rank"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore",
    "tsconfig.json"
  ],
  "adopt_tests": [
    "tests/stats.test.ts"
  ]
}
