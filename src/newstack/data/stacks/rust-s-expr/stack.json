{
  "name": "rust-s-expr",
  "title": "Rust S-Expression",
  "language": "rust",
  "blurb": "S-expression reader and evaluator: comments, strings, arithmetic, if/and/or, list ops.",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "An s-expression reader and evaluator with a REPL-free CLI.",
  "next_steps": [
    "cd {path}",
    "cargo run -- '(+ 1 2 3)'"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "src/lib.rs",
      "contains": "pub fn eval"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/s_expr.rs"
  ]
}
