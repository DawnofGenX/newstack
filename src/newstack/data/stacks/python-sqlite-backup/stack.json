{
  "name": "python-sqlite-backup",
  "title": "SQLite Backup",
  "language": "python",
  "blurb": "stdlib sqlite3 backup API: timestamped copies, integrity check, row-count verify, rotation",
  "default_description": "A CLI that backs up SQLite databases safely.",
  "requires": [
    "uv"
  ],
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install -e . pytest",
    ".venv/bin/python -m {package_name} backup ./data.db ./backups --keep 5"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "Connection.backup"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_backup.py"
  ]
}
