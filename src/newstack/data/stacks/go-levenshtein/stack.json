{
  "name": "go-levenshtein",
  "title": "Go Levenshtein",
  "language": "go",
  "blurb": "Levenshtein edit distance over runes plus closest match lookup, JSON output, table driven tests.",
  "requires": [
    "go",
    "git"
  ],
  "default_description": "An edit distance and fuzzy match CLI with rune aware counting.",
  "next_steps": [
    "cd {path}",
    "go build -o bin/app .",
    "./bin/app -a kitten -b sitting"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": [
        "go"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/{{ npm_name }} .",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "levenshtein.go",
      "contains": "func Distance"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "levenshtein_test.go"
  ]
}
