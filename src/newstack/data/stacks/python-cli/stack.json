{
  "name": "python-cli",
  "title": "Python CLI",
  "language": "python",
  "blurb": "Console command on argparse: zero runtime deps, tested entry point",
  "requires": [
    "uv",
    "git"
  ],
  "python": {
    "minimum": "3.10",
    "versions": ["3.10", "3.11", "3.12", "3.13"]
  },
  "default_description": "A command line tool.",
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run {npm_name} greet --name you"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv -q --allow-existing .venv && uv pip install -q --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "run",
      "cmd": ".venv/bin/{{ npm_name }} greet --name newstack",
      "tools": [
        "uv"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "pyproject.toml",
      "contains": "[project.scripts]"
    },
    {
      "file": "src"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_cli.py"
  ]
}
