{
  "name": "node-sqlite-import",
  "title": "Node SQLite Import",
  "language": "node",
  "blurb": "Import a CSV into SQLite (node:sqlite) and query it from the CLI",
  "requires": ["node", "npm"],
  "node": { "minimum": "22", "versions": ["22", "24"] },
  "package_manager": ["npm", "pnpm", "yarn"],
  "default_description": "A CSV-to-SQLite import and query CLI.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js import data.csv data.db"
  ],
  "verify": [
    { "name": "install", "cmd": "npm install --no-audit --no-fund", "tools": ["npm"], "timeout": 900 },
    { "name": "test", "cmd": "npm test", "tools": ["npm"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "node"], "timeout": 300 }
  ],
  "detect": [{ "file": "src/sqlite.js", "contains": "importCsv" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/sqlite.test.js"]
}
