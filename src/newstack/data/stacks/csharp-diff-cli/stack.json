{
  "name": "csharp-diff-cli",
  "title": "CSharp Diff CLI",
  "language": "csharp",
  "blurb": "Line-oriented unified diff CLI with xunit tests, no NuGet beyond test SDK.",
  "requires": [
    "dotnet",
    "git"
  ],
  "default_description": "A C# CLI that diffs two text files.",
  "next_steps": [
    "cd {path}",
    "dotnet build",
    "dotnet run -- old.txt new.txt"
  ],
  "verify": [
    {
      "name": "build",
      "cmd": "dotnet build --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "dotnet test --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "dotnet"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "Cli.cs",
      "contains": "csharp-diff-cli"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/DiffTests.cs"
  ]
}
