{
  "name": "csharp-semver-cli",
  "title": "C# semver CLI",
  "language": "csharp",
  "blurb": "Semantic version parser and range matcher: SemVer 2.0.0 ordering, caret/tilde/wildcard ranges, zero-dependency CLI",
  "requires": [
    "dotnet"
  ],
  "default_description": "A C# command line tool for semantic versions.",
  "next_steps": [
    "cd {path}",
    "dotnet test",
    "dotnet run -- parse 1.2.3-rc.1",
    "dotnet run -- satisfies 1.4.0 '^1.2.3'"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "dotnet test --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "dotnet build --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "SemVersion.cs",
      "contains": "public sealed class SemVersion"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
