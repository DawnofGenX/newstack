{
  "name": "node-json-patch-cli",
  "title": "Node JSON Patch CLI",
  "language": "node",
  "blurb": "RFC 6902 JSON Patch apply + diff, tests for add/remove/replace/move/copy/test and a failure case.",
  "requires": ["node", "npm"],
  "node": { "minimum": "22", "versions": ["22", "24"] },
  "package_manager": ["npm", "pnpm", "yarn"],
  "default_description": "A JSON Patch (RFC 6902) CLI.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js apply doc.json patch.json"
  ],
  "verify": [
    { "name": "install", "cmd": "npm install --no-audit --no-fund", "tools": ["npm"], "timeout": 900 },
    { "name": "test", "cmd": "npm test", "tools": ["npm"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "node"], "timeout": 300 }
  ],
  "detect": [{ "file": "src/patch.js", "contains": "applyPatch" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/patch.test.js"]
}