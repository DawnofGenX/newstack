{
  "name": "php-jwt-cli",
  "title": "PHP JWT CLI",
  "language": "php",
  "blurb": "HS256 JWT sign/verify CLI: base64url encode/decode, hash_equals, exp validation with an injected clock; PHPUnit tests",
  "requires": [
    "php",
    "composer",
    "git"
  ],
  "default_description": "A PHP JWT command line tool.",
  "next_steps": [
    "cd {path}",
    "composer install",
    "vendor/bin/phpunit",
    "php src/main.php sign secret '{{\"sub\":\"alice\",\"exp\":9999999999}}'"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "composer install --no-interaction && vendor/bin/phpunit",
      "tools": [
        "php",
        "composer"
      ],
      "timeout": 1800
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "php",
        "composer"
      ],
      "timeout": 1800
    }
  ],
  "detect": [
    {
      "file": "src/Jwt.php",
      "contains": "php-jwt-cli"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
