{
    "name": "{{ npm_name }}/{{ npm_name }}",
    "description": "{{ description }}",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "{{ package_name }}\\": "src/"
        },
        "files": [
            "src/Clock.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "{{ package_name }}\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
