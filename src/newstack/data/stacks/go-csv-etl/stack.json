{
  "name": "go-csv-etl",
  "title": "Go CSV ETL",
  "language": "go",
  "blurb": "Read, validate, dedupe, and aggregate CSV to JSON",
  "default_description": "A Go CSV ETL tool.",
  "requires": ["go", "git"],
  "next_steps": [
    "cd {path}",
    "go run . -in data/input.csv"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": ["go"],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": ["go"],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/etl .",
      "tools": ["go"],
      "timeout": 600
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": ["bash"],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "etl.go",
      "contains": "func Process"
    }
  ],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["etl_test.go"]
}
