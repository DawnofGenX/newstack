{
  "name": "go-circuit-breaker",
  "title": "Go Circuit Breaker",
  "language": "go",
  "blurb": "Circuit breaker state machine (closed/open/half-open) with clock-driven CLI",
  "requires": ["go", "git"],
  "default_description": "A circuit breaker library and CLI.",
  "next_steps": [
    "cd {path}",
    "go test ./...",
    "go build -o bin/cb .",
    "./bin/cb --demo"
  ],
  "verify": [
    { "name": "vet", "cmd": "go vet ./...", "tools": ["go"], "timeout": 300 },
    { "name": "test", "cmd": "go test ./...", "tools": ["go"], "timeout": 600 },
    { "name": "build", "cmd": "go build -o bin/cb .", "tools": ["go"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash"], "timeout": 300 }
  ],
  "detect": [{ "file": "breaker.go", "contains": "NewCircuitBreaker" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["breaker_test.go"]
}
