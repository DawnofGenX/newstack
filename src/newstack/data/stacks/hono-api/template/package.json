{
  "name": "{{ npm_name }}",
  "version": "0.1.0",
  "private": true,
  "description": "{{ description }}",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">={{ node_version }}"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
