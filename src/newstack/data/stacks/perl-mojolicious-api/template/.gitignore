# Everything `perl Makefile.PL` and `make` leave behind. Anchored with a
# leading slash on purpose: an unanchored `Makefile` would also hide
# `Makefile.PL` from git.
/Makefile
/Makefile.old
/MYMETA.json
/MYMETA.yml
/pm_to_blib
/blib/
/Textstat-*.tar.gz

# test and coverage noise
/.prove
/cover_db/

# editor and OS noise
.idea/
.vscode/
*.swp
*~
.DS_Store
