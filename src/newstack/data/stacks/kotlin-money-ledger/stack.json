{
  "name": "kotlin-money-ledger",
  "title": "Kotlin Money Ledger",
  "language": "kotlin",
  "blurb": "BigDecimal double-entry ledger CLI: exact money arithmetic, per-account balances, trial balance; JUnit5 tests",
  "requires": [
    "java",
    "gradle",
    "git"
  ],
  "default_description": "A Kotlin double entry ledger CLI using BigDecimal money.",
  "next_steps": [
    "cd {path}",
    "gradle test",
    "gradle run --args=ledger.csv"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "gradle test",
      "tools": [
        "java",
        "gradle"
      ],
      "timeout": 1800
    },
    {
      "name": "run",
      "cmd": "gradle run",
      "tools": [
        "java",
        "gradle"
      ],
      "timeout": 1800
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "java",
        "gradle"
      ],
      "timeout": 1800
    }
  ],
  "detect": [
    {
      "file": "src/main/kotlin/{{ package_name }}/Ledger.kt",
      "contains": "kotlin-money-ledger"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "src/test/kotlin/{{ package_name }}/LedgerTest.kt"
  ]
}
