{
  "name": "go-slog-middleware",
  "title": "Go slog Middleware",
  "language": "go",
  "blurb": "net/http + log/slog middleware: request id, structured logging, panic recovery, auth redaction.",
  "requires": ["go", "git"],
  "default_description": "A Go HTTP service with structured logging middleware.",
  "port": 5532,
  "next_steps": [
    "cd {path}",
    "go run .",
    "curl -sS http://127.0.0.1:5532/health"
  ],
  "verify": [
    { "name": "vet", "cmd": "go vet ./...", "tools": ["go"], "timeout": 300 },
    { "name": "test", "cmd": "go test ./...", "tools": ["go"], "timeout": 600 },
    { "name": "build", "cmd": "go build -o bin/server .", "tools": ["go"], "timeout": 600 },
    { "name": "http", "cmd": "bash smoke.sh", "tools": ["bash", "curl"], "timeout": 300 }
  ],
  "detect": [
    { "file": "internal/middleware/middleware.go", "contains": "WithRecovery" }
  ],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["main_test.go"]
}