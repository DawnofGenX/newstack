{
  "name": "python-bs4-scraper",
  "title": "BeautifulSoup Scraper",
  "language": "python",
  "blurb": "Offline HTML table/card extractor built on beautifulsoup4",
  "default_description": "A BeautifulSoup-based HTML extractor.",
  "requires": ["uv"],
  "python": {
    "minimum": "3.10",
    "versions": ["3.10", "3.11", "3.12", "3.13"]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install -e . pytest ruff",
    ".venv/bin/python -m {package_name} tables fixtures/sample.html"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest ruff",
      "tools": ["uv"],
      "timeout": 600
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": ["uv"],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest",
      "tools": ["uv"],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": ["uv"],
      "timeout": 300
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": ["bash"],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "pyproject.toml",
      "contains": "beautifulsoup4"
    }
  ],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/test_cli.py"]
}
