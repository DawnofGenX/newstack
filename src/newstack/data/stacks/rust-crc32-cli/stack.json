{
  "name": "rust-crc32-cli",
  "title": "Rust CRC-32 CLI",
  "language": "rust",
  "blurb": "CRC-32 (IEEE) and CRC-32C (Castagnoli) with incremental state, one-shot helpers and a checksum CLI.",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust CRC-32 and CRC-32C checksum CLI.",
  "next_steps": [
    "cargo test",
    "printf '123456789' | cargo run --quiet"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "src/lib.rs",
      "contains": "pub struct Crc32"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/crc.rs"
  ]
}
