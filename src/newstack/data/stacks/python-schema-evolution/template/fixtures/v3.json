{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order event",
  "description": "Additive: nobody's existing document can fail.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "type",
    "amount",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ord_[0-9]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "order.created",
        "order.paid"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": -100
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "customer": {
      "type": "string"
    }
  }
}
