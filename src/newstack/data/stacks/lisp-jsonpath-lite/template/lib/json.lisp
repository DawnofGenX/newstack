;;;; JSON parsing and a small JSONPath evaluator.
(defpackage :jsonpath.json
  (:use :cl)
  (:export #:parse-json #:eval-path #:format-json))

(in-package :jsonpath.json)

(defvar *text* "")
(defvar *i* 0)
(defvar *n* 0)

(defun skip-ws ()
  (loop while (and (< *i* *n*) (member (char *text* *i*) '(#\Space #\Tab #\Return #\Newline)))
        do (incf *i*)))

(defun parse-string ()
  (assert (char= (char *text* *i*) #\"))
  (incf *i*)
  (let ((out (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
    (loop
      (when (>= *i* *n*) (error "unterminated string"))
      (let ((c (char *text* *i*)))
        (cond
          ((char= c #\") (incf *i*) (return (coerce out 'string)))
          ((char= c #\\)
           (incf *i*)
           (let ((e (char *text* *i*)))
             (cond
               ((char= e #\n) (vector-push-extend #\Newline out))
               ((char= e #\t) (vector-push-extend #\Tab out))
               ((char= e #\r) (vector-push-extend #\Return out))
               ((char= e #\\) (vector-push-extend #\\ out))
               ((char= e #\") (vector-push-extend #\" out))
               (t (vector-push-extend e out)))))
          (t (vector-push-extend c out))))
      (incf *i*))))

(defun parse-number ()
  (let ((start *i*))
    (loop while (and (< *i* *n*)
                     (or (digit-char-p (char *text* *i*))
                         (member (char *text* *i*) '(#\. #\e #\E #\+ #\-))))
          do (incf *i*))
    (read-from-string (subseq *text* start *i*))))

(defun parse-literal (expected value)
  (let ((len (length expected)))
    (when (and (<= (+ *i* len) *n*)
               (string= (subseq *text* *i* (+ *i* len)) expected))
      (incf *i* len)
      (return-from parse-literal value))
    (error "bad literal")))

(defun parse-array ()
  (incf *i*)
  (skip-ws)
  (let ((items '()))
    (unless (char= (char *text* *i*) #\])
      (loop
        (push (parse-value) items)
        (skip-ws)
        (cond
          ((char= (char *text* *i*) #\,) (incf *i*) (skip-ws))
          ((char= (char *text* *i*) #\]) (incf *i*) (return (cons :array (reverse items))))
          (t (error "expected , or ]")))))
  (cons :array (reverse items))))

(defun parse-object ()
  (incf *i*)
  (skip-ws)
  (let ((pairs '()))
    (unless (char= (char *text* *i*) #\})
      (loop
        (skip-ws)
        (let ((key (parse-string)))
          (skip-ws)
          (unless (char= (char *text* *i*) #\:) (error "expected :"))
          (incf *i*)
          (let ((val (parse-value)))
            (push (cons key val) pairs))
          (skip-ws)
          (cond
            ((char= (char *text* *i*) #\,) (incf *i*) (skip-ws))
            ((char= (char *text* *i*) #\}) (incf *i*) (return (cons :object (reverse pairs))))
            (t (error "expected , or }"))))))
  (cons :object (reverse pairs))))

(defun parse-value ()
  (skip-ws)
  (cond
    ((>= *i* *n*) (error "unexpected eof"))
    ((char= (char *text* *i*) #\{) (parse-object))
    ((char= (char *text* *i*) #\[) (parse-array))
    ((char= (char *text* *i*) #\") (parse-string))
    ((char= (char *text* *i*) #\t) (parse-literal "true" :true))
    ((char= (char *text* *i*) #\f) (parse-literal "false" :false))
    ((char= (char *text* *i*) #\n) (parse-literal "null" :null))
    (t (parse-number))))

(defun parse-json (text)
  (let ((*text* text) (*i* 0) (*n* (length text)))
    (declare (special *text* *i* *n*))
    (skip-ws)
    (let ((v (parse-value)))
      (skip-ws)
      v)))

(defun jobj-p (x) (and (consp x) (eq (car x) :object)))
(defun jarr-p (x) (and (consp x) (eq (car x) :array)))

(defun obj-get (obj key)
  (cdr (assoc key (cdr obj) :test #'string=)))

(defun collect-recursive (node key)
  (let ((acc '()))
    (cond
      ((jobj-p node)
       (let ((v (obj-get node key)))
         (when v (push v acc)))
       (dolist (pair (cdr node))
         (setf acc (nconc acc (collect-recursive (cdr pair) key)))))
      ((jarr-p node)
       (dolist (item (cdr node))
         (setf acc (nconc acc (collect-recursive item key)))))
      (t nil))
    acc))

(defun step-path (nodes token)
  (cond
    ((eq token :all)
     (mapcan (lambda (n) (if (jarr-p n) (copy-list (cdr n)) '())) nodes))
    ((consp token)
     (let ((key (second token)))
       (mapcan (lambda (n) (collect-recursive n key)) nodes)))
    ((stringp token)
     (mapcan (lambda (n)
               (if (jobj-p n)
                   (let ((v (obj-get n token)))
                     (if v (list v) '()))
                   '()))
             nodes))
    (t nodes)))

(defun tokenize (s)
  (let ((i 0) (n (length s)) (toks '()))
    (loop while (< i n) do
      (cond
        ((char= (char s i) #\.)
         (incf i)
         (if (and (< i n) (char= (char s i) #\.))
             (progn
               (incf i)
               (let ((start i))
                 (loop while (and (< i n) (not (member (char s i) '(#\. #\[)))) do (incf i))
                 (push (list :recur (subseq s start i)) toks)))
             (let ((start i))
               (loop while (and (< i n) (not (member (char s i) '(#\. #\[)))) do (incf i))
               (push (subseq s start i) toks))))
        ((char= (char s i) #\[)
         (incf i)
         (cond
           ((and (< (+ i 1) n) (char= (char s i) #\*) (char= (char s (+ i 1)) #\]))
            (incf i 2)
            (push :all toks))
           (t (error "unsupported bracket"))))
        (t (error "unexpected char in path"))))
    (nreverse toks)))

(defun eval-path (json path)
  (let* ((p (string-trim " " path))
         (p (if (and (> (length p) 0) (char= (char p 0) #\$)) (subseq p 1) p))
         (toks (if (string= p "") '() (tokenize p))))
    (let ((frontier (list json)))
      (dolist (tok toks)
        (setf frontier (step-path frontier tok)))
      frontier)))

(defun format-json (v)
  (cond
    ((stringp v) (format nil "\"~a\"" v))
    ((numberp v) (princ-to-string v))
    ((eq v :true) "true")
    ((eq v :false) "false")
    ((eq v :null) "null")
    (t (princ-to-string v))))
