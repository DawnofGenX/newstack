{
  "name": "go-topk-cli",
  "title": "Go Top-K CLI",
  "language": "go",
  "blurb": "Top-K selection CLI: returns the K largest numbers from input using a min-heap, with pinned expected ordering.",
  "requires": ["go", "git"],
  "default_description": "A Go CLI that selects the top K values.",
  "next_steps": [
    "cd {path}",
    "go run . -k 3 5 1 9 2 8"
  ],
  "verify": [
    { "name": "vet", "cmd": "go vet ./...", "tools": ["go"], "timeout": 300 },
    { "name": "test", "cmd": "go test ./...", "tools": ["go"], "timeout": 600 },
    { "name": "build", "cmd": "go build -o bin/{{ npm_name }} .", "tools": ["go"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash"], "timeout": 300 }
  ],
  "detect": [{ "file": "topk.go", "contains": "func TopK" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["topk_test.go"]
}