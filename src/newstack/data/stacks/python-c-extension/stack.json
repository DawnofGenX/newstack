{
  "name": "python-c-extension",
  "title": "Python C extension",
  "language": "python",
  "blurb": "A CPython extension built by setuptools and checked against its own pure-Python reference: buffer-protocol arguments, embedded NULs, and a test that proves the import is the compiled module",
  "requires": [
    "python",
    "gcc"
  ],
  "default_description": "Text statistics with the counting loop in C.",
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install --python .venv/bin/python -e \".[dev]\"",
    ".venv/bin/python -m pytest -q",
    "echo 'a b' | .venv/bin/python -m {package_name}.cli -"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e \".[dev]\"",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "compiled",
      "cmd": ".venv/bin/python -c \"import {{ package_name }}; shared = {{ package_name }}._speedups.__file__; assert shared.endswith(('.so', '.pyd')), shared; print('compiled:', shared)\"",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "smoke",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": [
        "uv"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "**/*.c",
      "contains": "PyArg_ParseTuple"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore",
    "setup.py"
  ],
  "adopt_tests": [
    "tests/test_extension.py"
  ]
}
