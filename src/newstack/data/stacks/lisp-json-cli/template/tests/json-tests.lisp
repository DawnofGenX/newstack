(in-package :lisp-json.harness)
(defun json-tests ()
  (let ((out (json:pretty (json:parse "{\"b\":2,\"a\":1}"))))
    (check-text "sorted keys" out (concatenate 'string "{" (string #\Newline) "  \"a\": 1," (string #\Newline) "  \"b\": 2" (string #\Newline) "}")))
  (check-text "null/bool/array"
              (json:pretty (json:parse "[null,true,false,{\"z\":[1,2]}]"))
              (concatenate 'string "[" (string #\Newline)
                           "  null," (string #\Newline)
                           "  true," (string #\Newline)
                           "  false," (string #\Newline)
                           "  {" (string #\Newline)
                           "    \"z\": [" (string #\Newline)
                           "      1," (string #\Newline)
                           "      2" (string #\Newline)
                           "    ]" (string #\Newline)
                           "  }" (string #\Newline)
                           "]"))
  (let ((bad nil))
    (handler-case (json:parse "{bad}") (error () (setf bad t)))
    (check "invalid json raises" bad)))
