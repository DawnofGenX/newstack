;;;; JSON parser and pretty printer.
(defpackage :json
  (:use :cl)
  (:export #:parse #:pretty #:json-error))

(in-package :json)

(define-condition json-error (error)
  ((message :initarg :message :reader json-error-message))
  (:report (lambda (c s) (write-string (json-error-message c) s))))

(defun json-error (msg) (error 'json-error :message msg))

(defstruct jnull)
(defstruct jbool value)
(defstruct jarray items)
(defstruct jobject entries)

(defvar *text* "")
(defvar *pos* 0)

(defun text-len () (length *text*))
(defun peek-char* () (if (< *pos* (text-len)) (char *text* *pos*) nil))
(defun next-char () (prog1 (peek-char*) (incf *pos*)))
(defun skip-ws ()
  (loop while (and (< *pos* (text-len))
                   (member (char *text* *pos*) '(#\Space #\Tab #\Newline #\Return)))
        do (incf *pos*)))

(defun parse-string ()
  (unless (and (< *pos* (text-len)) (char= (char *text* *pos*) #\"))
    (json-error "expected string"))
  (incf *pos*)
  (with-output-to-string (out)
    (loop
      (let ((c (next-char)))
        (cond
          ((null c) (json-error "unterminated string"))
          ((char= c #\") (return))
          ((char= c #\\)
           (let ((e (next-char)))
             (case e
               (#\" (write-char #\" out))
               (#\\ (write-char #\\ out))
               (#\/ (write-char #\/ out))
               (#\b (write-char #\Backspace out))
               (#\f (write-char #\Page out))
               (#\n (write-char #\Newline out))
               (#\r (write-char #\Return out))
               (#\t (write-char #\Tab out))
               (#\u
                (let ((cp (parse-hex 4)))
                  (cond
                    ((and (<= #xD800 cp #xDBFF)
                          (< *pos* (text-len))
                          (char= (char *text* *pos*) #\\))
                     (let ((saved *pos*))
                       (incf *pos*)
                       (if (and (< *pos* (text-len)) (char= (char *text* *pos*) #\u))
                           (let ((low (parse-hex 4)))
                             (write-char (code-char (+ #x10000
                                                      (* (- cp #xD800) #x400)
                                                      (- low #xDC00))) out))
                           (progn (setf *pos* saved) (write-char (code-char cp) out)))))
                    (t (write-char (code-char cp) out)))))
               (t (json-error "bad escape")))))
          (t (write-char c out)))))))

(defun parse-hex (n)
  (let ((acc 0))
    (dotimes (i n)
      (let ((c (next-char)))
        (unless c (json-error "bad unicode escape"))
        (let ((v (cond ((digit-char-p c) (digit-char-p c))
                       ((char<= #\a c #\f) (- (char-code c) (char-code #\a) -10))
                       ((char<= #\A c #\F) (- (char-code c) (char-code #\A) -10))
                       (t nil))))
          (unless v (json-error "bad hex digit"))
          (setf acc (+ (* acc 16) v)))))
    acc))

(defun number-char-p (c)
  (or (digit-char-p c) (member c '(#\. #\e #\E #\+ #\-))))

(defun parse-number ()
  (let ((start *pos*))
    (loop while (and (< *pos* (text-len)) (number-char-p (char *text* *pos*)))
          do (incf *pos*))
    (when (= start *pos*) (json-error "expected number"))
    (let ((token (subseq *text* start *pos*)))
      (if (or (find #\. token) (find #\e token) (find #\E token))
          (let ((n (ignore-errors (read-from-string token))))
            (unless (numberp n) (json-error "bad number"))
            n)
          (let ((n (ignore-errors (parse-integer token))))
            (unless n (json-error "bad number"))
            n)))))

(defun parse-literal (word value)
  (let ((end (+ *pos* (length word))))
    (unless (and (<= end (text-len))
                 (string= *text* word :start1 *pos* :end1 end))
      (json-error "expected literal"))
    (setf *pos* end)
    value))

(defun parse-value ()
  (skip-ws)
  (let ((c (peek-char*)))
    (cond
      ((null c) (json-error "unexpected end of input"))
      ((char= c #\{) (parse-object))
      ((char= c #\[) (parse-array))
      ((char= c #\") (parse-string))
      ((char= c #\t) (parse-literal "true" (make-jbool :value t)))
      ((char= c #\f) (parse-literal "false" (make-jbool :value nil)))
      ((char= c #\n) (parse-literal "null" (make-jnull)))
      (t (parse-number)))))

(defun parse-object ()
  (incf *pos*) ; {
  (skip-ws)
  (let ((entries nil))
    (if (and (< *pos* (text-len)) (char= (char *text* *pos*) #\}))
        (incf *pos*)
        (loop
          (skip-ws)
          (let ((key (parse-string)))
            (skip-ws)
            (unless (and (< *pos* (text-len)) (char= (char *text* *pos*) #\:))
              (json-error "expected colon"))
            (incf *pos*)
            (let ((val (parse-value)))
              (push (cons key val) entries))
            (skip-ws)
            (let ((c (peek-char*)))
              (cond
                ((and c (char= c #\,)) (incf *pos*))
                ((and c (char= c #\})) (incf *pos*) (return))
                (t (json-error "expected , or }")))))))
    (make-jobject :entries entries)))

(defun parse-array ()
  (incf *pos*) ; [
  (skip-ws)
  (let ((items nil))
    (if (and (< *pos* (text-len)) (char= (char *text* *pos*) #\]))
        (incf *pos*)
        (loop
          (let ((val (parse-value)))
            (push val items))
          (skip-ws)
          (let ((c (peek-char*)))
            (cond
              ((and c (char= c #\,)) (incf *pos*) (skip-ws))
              ((and c (char= c #\])) (incf *pos*) (return))
              (t (json-error "expected , or ]"))))))
    (make-jarray :items (nreverse items))))

(defun parse (text)
  (let ((*text* text) (*pos* 0))
    (let ((value (parse-value)))
      (skip-ws)
      (unless (= *pos* (text-len)) (json-error "trailing data"))
      value)))

(defun write-json-string (stream s)
  (write-char #\" stream)
  (loop for ch across s do
    (case ch
      (#\" (write-string "\\\"" stream))
      (#\\ (write-string "\\\\" stream))
      (#\Backspace (write-string "\\b" stream))
      (#\Page (write-string "\\f" stream))
      (#\Newline (write-string "\\n" stream))
      (#\Return (write-string "\\r" stream))
      (#\Tab (write-string "\\t" stream))
      (t (if (< (char-code ch) #x20)
             (format stream "\\u~4,'0x" (char-code ch))
             (write-char ch stream)))))
  (write-char #\" stream))

(defun indent (stream level)
  (dotimes (i level) (write-char #\Space stream)))

(defun write-value (stream value level)
  (typecase value
    (jnull (write-string "null" stream))
    (jbool (write-string (if (jbool-value value) "true" "false") stream))
    (string (write-json-string stream value))
    (integer (princ value stream))
    (float (princ value stream))
    (jarray
     (let ((items (jarray-items value)))
       (if (null items)
           (write-string "[]" stream)
           (progn
             (write-string "[" stream)
             (let ((first t))
               (dolist (item items)
                 (unless first (write-char #\, stream))
                 (setf first nil)
                 (terpri stream)
                 (indent stream (+ level 2))
                 (write-value stream item (+ level 2))))
             (terpri stream)
             (indent stream level)
             (write-char #\] stream)))))
    (jobject
     (let* ((entries (jobject-entries value))
            (sorted (sort (copy-list entries) #'string< :key #'car)))
       (if (null sorted)
           (write-string "{}" stream)
           (progn
             (write-string "{" stream)
             (let ((first t))
               (dolist (entry sorted)
                 (unless first (write-char #\, stream))
                 (setf first nil)
                 (terpri stream)
                 (indent stream (+ level 2))
                 (write-json-string stream (car entry))
                 (write-string ": " stream)
                 (write-value stream (cdr entry) (+ level 2))))
             (terpri stream)
             (indent stream level)
             (write-char #\} stream)))))
    (t (json-error "unsupported value"))))

(defun pretty (value)
  (with-output-to-string (stream)
    (write-value stream value 0)))
