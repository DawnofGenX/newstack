{
  "name": "go-matrix-cli",
  "title": "Go matrix CLI",
  "language": "go",
  "blurb": "JSON-in, JSON-out matrix arithmetic: determinant by Gaussian elimination, product, transpose, trace, identity.",
  "requires": ["go", "git"],
  "default_description": "A matrix arithmetic CLI that reads JSON matrices.",
  "next_steps": [
    "cd {path}",
    "go build -o bin/{{ npm_name }} .",
    "echo '[[1,2],[3,4]]' | bin/{{ npm_name }} det"
  ],
  "verify": [
    { "name": "vet", "cmd": "go vet ./...", "tools": ["go"], "timeout": 300 },
    { "name": "test", "cmd": "go test ./...", "tools": ["go"], "timeout": 600 },
    { "name": "build", "cmd": "go build -o bin/{{ npm_name }} .", "tools": ["go"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "go"], "timeout": 600 }
  ],
  "detect": [{ "file": "matrix.go", "contains": "func Multiply(left, right Matrix)" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["matrix_test.go"]
}
