{
  "name": "go-hyperloglog",
  "title": "Go HyperLogLog",
  "language": "go",
  "blurb": "HyperLogLog cardinality estimator CLI.",
  "requires": [
    "go",
    "git"
  ],
  "default_description": "A HyperLogLog cardinality estimator.",
  "next_steps": [
    "cd {path}",
    "go run . -file data.txt"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": [
        "go"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/{{ npm_name }} .",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "main.go",
      "contains": "HyperLogLog"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "hyperloglog_test.go"
  ]
}
