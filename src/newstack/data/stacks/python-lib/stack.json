{
  "name": "python-lib",
  "title": "Python library",
  "language": "python",
  "blurb": "Installable package: src layout, pytest, ruff, 4-version CI matrix",
  "requires": [
    "uv",
    "git"
  ],
  "default_description": "A Python library.",
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run pytest"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv -q .venv && uv pip install -q --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "pyproject.toml"
    }
  ],
  "detect_fallback": true,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_core.py"
  ]
}
