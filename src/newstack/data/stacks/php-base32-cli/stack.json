{
  "name": "php-base32-cli",
  "title": "PHP Base32 CLI",
  "language": "php",
  "blurb": "RFC 4648 base32 encoder/decoder plus Crockford alphabet, stdin and file input, PHPUnit suite",
  "requires": [
    "php",
    "composer"
  ],
  "default_description": "A PHP base32 encoder and decoder CLI.",
  "next_steps": [
    "cd {path}",
    "composer install",
    "vendor/bin/phpunit",
    "printf 'foobar' | php bin/{npm_name} encode"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "composer install --no-interaction --prefer-dist && vendor/bin/phpunit",
      "tools": [
        "composer",
        "php"
      ],
      "timeout": 900
    },
    {
      "name": "encode",
      "cmd": "printf 'foobar' | php bin/{{ npm_name }} encode | grep -qx 'MZXW6YTBOI======'",
      "tools": [
        "php"
      ],
      "timeout": 120
    },
    {
      "name": "decode",
      "cmd": "printf 'MZXW6YTBOI======' | php bin/{{ npm_name }} decode | grep -qx 'foobar'",
      "tools": [
        "php"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "php bin/{{ npm_name }} bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "php"
      ],
      "timeout": 120
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "php",
        "composer",
        "bash"
      ],
      "timeout": 900
    }
  ],
  "detect": [
    {
      "file": "src/Base32.php",
      "contains": "final class Base32"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/Base32Test.php"
  ]
}
