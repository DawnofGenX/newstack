{
  "name": "node-url-normalizer",
  "title": "Node URL Normalizer",
  "language": "node",
  "blurb": "URL normalization: host casing, default ports, query sorting, tracking params.",
  "requires": [
    "node",
    "npm"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A URL normalizer for Node.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js \"https://Example.COM:443/a/?utm_source=x&b=2&a=1\""
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "src/normalize.js",
      "contains": "normalizeUrl"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/normalize.test.js"
  ]
}
