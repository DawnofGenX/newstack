{
  "name": "rust-bitfield-cli",
  "title": "Rust Bitfield CLI",
  "language": "rust",
  "blurb": "Bitfield inspector/manipulator CLI (set/clear/toggle bits) with hex/dec/binary output and tests",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust CLI for inspecting and manipulating bitfields.",
  "next_steps": [
    "cd {path}",
    "cargo run -- 0 --set 3 --set 0"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "src/lib.rs",
      "contains": "pub fn apply"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/cli.rs"
  ]
}
