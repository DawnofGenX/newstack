{
  "name": "python-xlsx-report",
  "title": "XLSX Report",
  "language": "python",
  "blurb": "openpyxl reports from CSV: styled header, freeze panes, widths, number formats, autofilter, formula",
  "default_description": "A CLI that turns CSV into an xlsx report.",
  "requires": [
    "uv"
  ],
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install -e . pytest",
    ".venv/bin/python -m {package_name} report ./data.csv ./report.xlsx"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest openpyxl ruff",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "openpyxl"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_report.py"
  ]
}
