{
  "name": "bun-sqlite-api",
  "title": "Bun + bun:sqlite API",
  "language": "bun",
  "blurb": "Bun with no dependencies at all: Bun.serve routes, bun:sqlite with per-connection PRAGMAs, transactional numbered migrations, bun:test suite and a restart-persistence smoke",
  "requires": [
    "bun",
    "curl"
  ],
  "default_description": "A notes API on Bun backed by bun:sqlite.",
  "next_steps": [
    "cd {path}",
    "bun test",
    "PORT=5471 DB_PATH=./notes.db bun run src/main.js",
    "bash smoke.sh"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "bun install",
      "tools": [
        "bun"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "bun test",
      "tools": [
        "bun"
      ],
      "timeout": 600
    },
    {
      "name": "selftest",
      "cmd": "bun run src/main.js --selftest",
      "tools": [
        "bun"
      ],
      "timeout": 300
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": [
        "bun",
        "curl"
      ],
      "timeout": 900
    }
  ],
  "detect": [
    {
      "file": "**/*.js",
      "contains": "bun:sqlite"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "test/notes.test.js"
  ]
}
