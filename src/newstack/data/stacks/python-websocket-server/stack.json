{
  "name": "python-websocket-server",
  "title": "Python WebSocket server",
  "language": "python",
  "blurb": "An RFC 6455 server on the standard library alone: the upgrade handshake, framing with 7/16/64-bit lengths, fragmentation and control frames, masking enforced in one direction only, and a JSON stats protocol over the socket.",
  "requires": [
    "python",
    "uv"
  ],
  "default_description": "A WebSocket service that counts words over a live socket.",
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "port": 5489,
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing && uv pip install -e '.[dev]'",
    ".venv/bin/{npm_name} --port 5489",
    "bash smoke.sh"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e '.[dev]'",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "uv",
        "curl"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "Sec-WebSocket-Accept"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_protocol.py"
  ]
}
