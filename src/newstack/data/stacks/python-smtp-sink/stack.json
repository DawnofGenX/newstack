{
  "name": "python-smtp-sink",
  "title": "Python SMTP sink",
  "language": "python",
  "blurb": "A capturing SMTP server (aiosmtpd): every message becomes an .eml file plus one index line, oversized mail is refused with 552, policy refusals are 550, 8-bit headers are accepted with SMTPUTF8, and the index can be rebuilt from the files alone",
  "requires": [
    "python"
  ],
  "default_description": "A capturing SMTP sink for development.",
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install --python .venv/bin/python -e \".[dev]\"",
    "uv run {npm_name} serve --port 5482 --mailbox mailbox",
    "uv run {npm_name} list --mailbox mailbox --json"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e \".[dev]\"",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "http",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": [
        "uv"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "aiosmtpd"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_sink.py"
  ],
  "port": 5482
}
