{
  "name": "rust-job-queue",
  "title": "Rust Job Queue",
  "language": "rust",
  "blurb": "In-process job queue: mpsc channel, N workers, retry with max attempts, graceful shutdown, results collected",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust job queue command line tool.",
  "next_steps": [
    "cd {path}",
    "cargo test",
    "cargo run -- 4"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "Cargo.toml",
      "contains": "job-queue"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
