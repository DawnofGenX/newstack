{
  "name": "python-eval-harness",
  "title": "Python evaluation harness",
  "language": "python",
  "blurb": "Reproducible offline eval harness: JSONL gold + predictions, exact_match/token_f1, per-example records you can diff with a CI-friendly exit code",
  "requires": [
    "uv",
    "python3"
  ],
  "default_description": "A reproducible evaluation harness for model outputs.",
  "python": {
    "minimum": "3.12",
    "versions": [
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install --python .venv/bin/python -e . pytest ruff",
    ".venv/bin/python -m {package_name} run --data data/dev.jsonl --predictions data/predictions.good.jsonl",
    ".venv/bin/python -m pytest"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "lint",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "stdin",
      "cmd": "printf '{\"id\":\"cap-1\",\"prediction\":\"Paris\"}\\n' | .venv/bin/python -m {{ package_name }} run --data data/dev.jsonl --predictions - | grep -q 'answered  1/4'",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "missing-file",
      "cmd": ".venv/bin/python -m {{ package_name }} run --data data/dev.jsonl --predictions data/nope.jsonl >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "*.jsonl",
      "contains": "\"gold\""
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_harness.py"
  ]
}
