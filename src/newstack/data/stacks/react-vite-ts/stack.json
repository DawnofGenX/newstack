{
  "name": "react-vite-ts",
  "title": "React + Vite + TypeScript",
  "language": "node",
  "blurb": "SPA with Vitest + Testing Library, typed build, CI",
  "requires": [
    "node",
    "npm",
    "git"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A React single page application.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_run} dev"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "typecheck",
      "cmd": "npm run typecheck",
      "tools": [
        "npm"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 300
    },
    {
      "name": "build",
      "cmd": "npm run build",
      "tools": [
        "npm"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "package.json",
      "contains": "\"react\""
    }
  ],
  "detect_fallback": true,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "adopt_tests": [
    "src/App.test.tsx"
  ]
}
