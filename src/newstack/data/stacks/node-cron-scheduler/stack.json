{
  "name": "node-cron-scheduler",
  "title": "Node Cron Scheduler",
  "language": "node",
  "blurb": "In-process scheduler (dep: node-cron) that registers jobs, runs them, and records last-run/last-error in a small JSON store",
  "requires": [
    "node",
    "npm"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "An in-process cron scheduler built with node-cron.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "node src/cli.js --duration 3000",
    "cat jobs.json"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "package.json",
      "contains": "node-cron"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/scheduler.test.js"
  ]
}