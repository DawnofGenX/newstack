{
  "name": "lua-csv-cli",
  "title": "Lua CSV CLI",
  "language": "lua",
  "blurb": "Lua 5.4 CSV tool: RFC 4180 parser with width checks, column selection by name or position, CSV/TSV/JSON output, dependency-free spec runner",
  "requires": [
    "lua5.4"
  ],
  "default_description": "A Lua command line tool that converts delimited text between CSV, TSV and JSON.",
  "next_steps": [
    "cd {path}",
    "./bin/{npm_name} --help",
    "printf 'id,name\\n1,alpha\\n' | ./bin/{npm_name} -o json",
    "lua5.4 spec/run.lua"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "lua5.4 spec/run.lua",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} does-not-exist.csv >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "tsv",
      "cmd": "printf 'id,name\\n1,alpha\\n' | ./bin/{{ npm_name }} -o tsv | grep -q 'alpha'",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    },
    {
      "name": "json",
      "cmd": "printf 'id,name\\n1,alpha\\n' | ./bin/{{ npm_name }} -o json | grep -q 'alpha'",
      "tools": [
        "lua5.4"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "src/csval/parse.lua",
      "contains": "function M.parse"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore",
    ".luarc.json"
  ],
  "adopt_tests": []
}
