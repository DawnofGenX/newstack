{
  "name": "python-content-addressed-store",
  "title": "Content-Addressed Store",
  "language": "python",
  "blurb": "Dependency-free content-addressed blob store with atomic writes, dedupe, verify and gc",
  "default_description": "A CLI content-addressed store for blobs.",
  "requires": [
    "uv"
  ],
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install -e . pytest",
    ".venv/bin/python -m {package_name} put ./store ./file.txt --name readme"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "manifest.json"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_cas.py"
  ]
}
