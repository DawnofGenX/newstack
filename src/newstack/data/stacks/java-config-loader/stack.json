{
  "name": "java-config-loader",
  "title": "Java Config Loader",
  "language": "java",
  "blurb": "Properties-based config loader CLI with env overrides, defaults, typed getters, JUnit5 tests",
  "requires": [
    "java",
    "mvn",
    "git"
  ],
  "default_description": "A Java CLI that loads and resolves configuration from properties files.",
  "next_steps": [
    "cd {path}",
    "mvn -B package",
    "java -jar target/{{ npm_name }}.jar config.properties db.host localhost"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "mvn -B test",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "package",
      "cmd": "mvn -B package -DskipTests",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "java",
        "mvn"
      ],
      "timeout": 1800
    }
  ],
  "detect": [
    {
      "file": "src/main/java/{{ package_name }}/ConfigLoader.java",
      "contains": "class ConfigLoader"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "src/test/java/{{ package_name }}/ConfigLoaderTest.java"
  ]
}
