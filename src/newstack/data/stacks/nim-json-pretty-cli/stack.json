{
  "name": "nim-json-pretty-cli",
  "title": "Nim JSON Pretty CLI",
  "language": "nim",
  "blurb": "Nim 1.6+ CLI: pretty print and sort JSON keys, --indent, --compact, stdin or file",
  "requires": [
    "nim",
    "nimble"
  ],
  "default_description": "A Nim command line tool.",
  "next_steps": [
    "cd {path}",
    "nimble build",
    "./{package_name} --help",
    "nimble test"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "nimble test",
      "tools": [
        "nim",
        "nimble"
      ],
      "timeout": 900
    },
    {
      "name": "build",
      "cmd": "nimble build",
      "tools": [
        "nim",
        "nimble"
      ],
      "timeout": 900
    },
    {
      "name": "help",
      "cmd": "./{{ package_name }} --help",
      "tools": [
        "nim",
        "nimble"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "./{{ package_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "nim",
        "nimble"
      ],
      "timeout": 120
    },
    {
      "name": "stdin",
      "cmd": "printf '{\"b\":2,\"a\":1}' | ./{{ package_name }} --compact",
      "tools": [
        "nim",
        "nimble"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "nim.cfg",
      "contains": "nim-json-pretty-cli"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}