{
  "name": "d-cli",
  "title": "D CLI",
  "language": "d",
  "blurb": "D program compiled with LDC: counting over ubyte[], hand-written argv parser, report building behind an Io struct of function pointers, dependency-free D test harness and a parity suite that diffs against wc",
  "requires": [
    "ldc2",
    "make"
  ],
  "default_description": "A D command line tool.",
  "next_steps": [
    "cd {path}",
    "make test",
    "make parity",
    "./bin/{npm_name} --help",
    "./bin/{npm_name} README.md"
  ],
  "verify": [
    {
      "name": "build",
      "cmd": "make build",
      "tools": [
        "ldc2"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "make test",
      "tools": [
        "ldc2"
      ],
      "timeout": 300
    },
    {
      "name": "parity",
      "cmd": "make parity",
      "tools": [
        "ldc2",
        "wc"
      ],
      "timeout": 300
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "ldc2"
      ],
      "timeout": 180
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "ldc2"
      ],
      "timeout": 180
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "ldc2"
      ],
      "timeout": 180
    },
    {
      "name": "stdin",
      "cmd": "printf 'a b c\\n' | ./bin/{{ npm_name }} | grep -q '1       3       6'",
      "tools": [
        "ldc2"
      ],
      "timeout": 180
    }
  ],
  "detect": [
    {
      "file": "source/app.d"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
