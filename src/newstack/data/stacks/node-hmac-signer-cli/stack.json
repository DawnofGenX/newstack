{
  "name": "node-hmac-signer-cli",
  "title": "Node HMAC Signer CLI",
  "language": "node",
  "blurb": "HMAC-SHA256 request signer/verifier CLI (node:crypto only), timing-safe verify with timestamp tolerance.",
  "requires": ["node", "npm"],
  "node": { "minimum": "22", "versions": ["22", "24"] },
  "package_manager": ["npm", "pnpm", "yarn"],
  "default_description": "An HMAC-SHA256 request signer/verifier CLI.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js sign --secret mysecret --payload hello"
  ],
  "verify": [
    { "name": "install", "cmd": "npm install --no-audit --no-fund", "tools": ["npm"], "timeout": 900 },
    { "name": "test", "cmd": "npm test", "tools": ["npm"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "node"], "timeout": 300 }
  ],
  "detect": [{ "file": "src/hmac.js", "contains": "timingSafeEqual" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/hmac.test.js"]
}
