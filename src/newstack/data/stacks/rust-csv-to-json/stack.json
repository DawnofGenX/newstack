{
  "name": "rust-csv-to-json",
  "title": "Rust CSV to JSON",
  "language": "rust",
  "blurb": "CSV to JSON converter CLI (csv + serde_json crates) with stdin/file input and integration tests",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust CLI that converts CSV to JSON.",
  "next_steps": [
    "cd {path}",
    "cargo run -- input.csv"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "src/lib.rs",
      "contains": "csv_to_json"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/cli.rs"
  ]
}
