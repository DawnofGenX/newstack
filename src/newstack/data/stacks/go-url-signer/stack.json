{
  "name": "go-url-signer",
  "title": "Go URL Signer",
  "language": "go",
  "blurb": "HMAC-SHA256 signed URLs with expiry, middleware that gates handlers, httptest coverage, ephemeral port.",
  "requires": [
    "go",
    "git"
  ],
  "default_description": "Signed URL generation and verification middleware for net/http.",
  "next_steps": [
    "cd {path}",
    "go build -o bin/app .",
    "./bin/app -secret s3cr3t -path /files/report.pdf -ttl 60s"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": [
        "go"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/{{ npm_name }} .",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "signer.go",
      "contains": "type URLSigner struct"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "signer_test.go"
  ]
}
