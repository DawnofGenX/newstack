{
  "name": "go-rate-limiter",
  "title": "Go Rate Limiter",
  "language": "go",
  "blurb": "Token-bucket HTTP rate limiter middleware with 429 + Retry-After",
  "default_description": "A Go HTTP service with rate limiting.",
  "port": 5540,
  "requires": ["go", "git"],
  "next_steps": [
    "cd {path}",
    "go run .",
    "curl -sS http://127.0.0.1:5540/health"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": ["go"],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": ["go"],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/server .",
      "tools": ["go"],
      "timeout": 600
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": ["bash", "curl"],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "main.go",
      "contains": "TokenBucketLimiter"
    }
  ],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["main_test.go"]
}
