{
  "name": "dart-csv-cli",
  "title": "Dart CSV CLI",
  "language": "dart",
  "blurb": "Dart 3 CSV tool: RFC 4180 parser, column projection, JSON output, package:test suites.",
  "requires": [
    "dart"
  ],
  "default_description": "A Dart CLI that parses CSV, projects columns and prints CSV or JSON.",
  "next_steps": [
    "cd {path}",
    "dart pub get",
    "dart run bin/{npm_name}.dart data.csv",
    "dart test"
  ],
  "verify": [
    {
      "name": "get",
      "cmd": "dart pub get",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "analyze",
      "cmd": "dart analyze --fatal-infos",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "test",
      "cmd": "dart test",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "help",
      "cmd": "dart run bin/{{ npm_name }}.dart --help",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "usage-error",
      "cmd": "dart run bin/{{ npm_name }}.dart --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "missing-file",
      "cmd": "dart run bin/{{ npm_name }}.dart does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "sh smoke.sh",
      "tools": [
        "dart",
        "sh"
      ],
      "timeout": 900
    }
  ],
  "detect": [
    {
      "file": "lib/src/csv.dart",
      "contains": "final class CsvTable"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "test/csv_test.dart"
  ]
}
