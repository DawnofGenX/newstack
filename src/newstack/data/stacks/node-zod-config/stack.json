{
  "name": "node-zod-config",
  "title": "Node Zod Config",
  "language": "node",
  "blurb": "Typed config loader: zod schema, precedence defaults<file<env<CLI, CLI writes resolved JSON.",
  "requires": ["node", "npm"],
  "node": { "minimum": "22", "versions": ["22", "24"] },
  "package_manager": ["npm", "pnpm", "yarn"],
  "default_description": "A typed config loader built with zod.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js --config config.json --port 8080 --out resolved.json"
  ],
  "verify": [
    { "name": "install", "cmd": "npm install --no-audit --no-fund", "tools": ["npm"], "timeout": 900 },
    { "name": "test", "cmd": "npm test", "tools": ["npm"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "node"], "timeout": 300 }
  ],
  "detect": [{ "file": "src/config.js", "contains": "ConfigSchema" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/config.test.js"]
}