{
  "name": "csharp-duration-cli",
  "title": "C# Duration CLI",
  "language": "csharp",
  "blurb": "ISO 8601 duration arithmetic on .NET 8: parse P2DT3H and 1h30m, format both ways, add to a timestamp, and refuse ambiguous calendar months",
  "requires": [
    "dotnet",
    "git"
  ],
  "default_description": "A C# CLI for ISO 8601 duration arithmetic.",
  "next_steps": [
    "cd {path}",
    "dotnet build",
    "dotnet run -- parse 1h30m",
    "dotnet run -- add P1D --from 2026-01-31T23:30:00Z"
  ],
  "verify": [
    {
      "name": "build",
      "cmd": "dotnet build --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "test",
      "cmd": "dotnet test --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "parse",
      "cmd": "dotnet run --no-build -- parse 1h30m | grep -qx 'iso=PT1H30M'",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "add",
      "cmd": "dotnet run --no-build -- add P1D --from 2026-01-31T23:30:00Z | grep -qx 'to=2026-02-01T23:30:00Z'",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "calendar-refused",
      "cmd": "dotnet run --no-build -- parse P1Y >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "usage-error",
      "cmd": "dotnet run --no-build -- frobnicate >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "dotnet",
        "bash"
      ],
      "timeout": 900
    }
  ],
  "detect": [
    {
      "file": "IsoDuration.cs",
      "contains": "public sealed class IsoDuration"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/DurationTests.cs"
  ]
}
