{
  "name": "go-ulid-cli",
  "title": "Go ULID CLI",
  "language": "go",
  "blurb": "Time sortable ULID generation and parsing over Crockford base32, crypto/rand entropy, millisecond round trip.",
  "requires": [
    "go",
    "git"
  ],
  "default_description": "A ULID generator and parser with millisecond timestamps.",
  "next_steps": [
    "cd {path}",
    "go build -o bin/app .",
    "./bin/app -gen -n 3"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": [
        "go"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/{{ npm_name }} .",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "ulid.go",
      "contains": "crockford"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "ulid_test.go"
  ]
}
