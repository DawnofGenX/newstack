{
  "name": "rust-threadpool",
  "title": "Rust Thread Pool",
  "language": "rust",
  "blurb": "Fixed-size worker thread pool library + CLI demo: submit jobs over a channel, results collected, graceful shutdown",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust worker thread pool library with a CLI demo.",
  "next_steps": [
    "cd {path}",
    "cargo test",
    "cargo run -- 4"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "Cargo.toml",
      "contains": "threadpool"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/pool.rs"
  ]
}
