{
  "name": "ruby-json-diff-cli",
  "title": "Ruby JSON Diff CLI",
  "blurb": "Deep structural diff of two JSON documents in Ruby stdlib",
  "language": "ruby",
  "requires": [
    "ruby",
    "rake",
    "git"
  ],
  "default_description": "A Ruby command line JSON diff tool.",
  "next_steps": [
    "cd {path}",
    "rake test",
    "bin/{npm_name} diff '{\"a\":1}' '{\"a\":2}'"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "rake test",
      "tools": [
        "ruby",
        "rake"
      ],
      "timeout": 600
    },
    {
      "name": "diff",
      "cmd": "bin/{{ npm_name }} diff '{\"a\":1}' '{\"a\":2}' | grep -q 'a: 1 -> 2'",
      "tools": [
        "ruby"
      ],
      "timeout": 300
    },
    {
      "name": "no-diff",
      "cmd": "bin/{{ npm_name }} diff '{\"a\":1}' '{\"a\":1}' | grep -qx 'no differences'",
      "tools": [
        "ruby"
      ],
      "timeout": 300
    },
    {
      "name": "usage-error",
      "cmd": "bin/{{ npm_name }} frobnicate >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "ruby"
      ],
      "timeout": 300
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "ruby",
        "rake",
        "bash"
      ],
      "timeout": 900
    }
  ],
  "detect": [
    {
      "file": "lib/json_diff.rb",
      "contains": "module JsonDiff"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "test/json_diff_test.rb"
  ]
}