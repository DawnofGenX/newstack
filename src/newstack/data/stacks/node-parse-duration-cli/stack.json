{
  "name": "node-parse-duration-cli",
  "title": "Node Parse Duration CLI",
  "language": "node",
  "blurb": "Duration string parser CLI: converts '1h30m', '2d', '500ms' to milliseconds with a hand-written tokenizer and pinned vectors.",
  "requires": ["node", "npm"],
  "node": { "minimum": "22", "versions": ["22", "24"] },
  "package_manager": ["npm", "pnpm", "yarn"],
  "default_description": "A Node CLI that parses duration strings into milliseconds.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js 1h30m"
  ],
  "verify": [
    { "name": "install", "cmd": "npm install --no-audit --no-fund", "tools": ["npm"], "timeout": 900 },
    { "name": "test", "cmd": "npm test", "tools": ["npm"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "node"], "timeout": 300 }
  ],
  "detect": [{ "file": "src/parse.js", "contains": "export function parseDuration" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/parse.test.js"]
}