{
  "name": "crystal-cli",
  "title": "Crystal CLI",
  "language": "crystal",
  "blurb": "Crystal 1.11+ CLI: a pure counting struct, a hand-written option parser, a stdlib spec suite and a shard with zero dependencies",
  "requires": [
    "crystal"
  ],
  "default_description": "A Crystal command line tool.",
  "next_steps": [
    "cd {path}",
    "crystal spec",
    "mkdir -p bin && crystal build -o bin/{npm_name} src/textstat.cr",
    "bin/{npm_name} --help"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "crystal spec",
      "tools": [
        "crystal"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "mkdir -p bin && crystal build -o bin/{{ npm_name }} src/textstat.cr",
      "tools": [
        "crystal"
      ],
      "timeout": 600
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "shard.yml",
      "contains": "crystal:"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
