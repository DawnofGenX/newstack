{
  "name": "python-mqtt-broker",
  "title": "Python MQTT broker",
  "language": "python",
  "blurb": "An MQTT 3.1.1 broker: sessions, wildcards, retained messages, QoS 0/1.",
  "default_description": "An MQTT 3.1.1 broker with sessions, wildcards and retained messages.",
  "port": 5488,
  "requires": [
    "python",
    "uv",
    "mosquitto-clients"
  ],
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e \".[dev]\"",
      "timeout": 900
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check ."
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest -q"
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} --selftest"
    },
    {
      "name": "http",
      "cmd": "PY=.venv/bin/python bash smoke.sh"
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "def encode_remaining_length"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_broker.py"
  ],
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing && uv pip install -e \".[dev]\"",
    ".venv/bin/python -m {package_name} --port 5488",
    "mosquitto_sub -h 127.0.0.1 -p 5488 -t 'room/#' -v"
  ]
}
