{
  "name": "python-bk-tree",
  "title": "Fuzzy Search",
  "language": "python",
  "blurb": "Edit distance plus a Burkhard-Keller tree: a word is found by distance without comparing it to every word, and the pruning is proved against a full scan on the same corpus.",
  "requires": [
    "uv",
    "python3"
  ],
  "default_description": "A fuzzy word lookup that prunes with a triangle inequality and checks its own pruning against a full scan.",
  "python": {
    "minimum": "3.12",
    "versions": [
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run {npm_name} demo",
    "uv run {npm_name} distance kitten sitting",
    "uv run {npm_name} search --words fixtures/words.txt --word helo --distance 2",
    "PY=.venv/bin/python bash smoke.sh"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --python 3.12 --allow-existing && uv pip install --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "lint",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 120
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} selftest",
      "tools": [
        "uv"
      ],
      "timeout": 120
    },
    {
      "name": "smoke",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 180
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "skipped without looking inside it"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".gitignore",
    ".github/workflows/ci.yml"
  ],
  "adopt_tests": [
    "tests/test_tree.py"
  ]
}
