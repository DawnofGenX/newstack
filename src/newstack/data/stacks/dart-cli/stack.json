{
  "name": "dart-cli",
  "title": "Dart CLI",
  "language": "dart",
  "blurb": "Dart 3 CLI: pub package with a pure counting library, package:test suite and zero runtime dependencies",
  "requires": [
    "dart"
  ],
  "default_description": "A Dart command line tool.",
  "next_steps": [
    "cd {path}",
    "dart pub get",
    "dart run bin/{npm_name}.dart --help",
    "dart test"
  ],
  "verify": [
    {
      "name": "get",
      "cmd": "dart pub get",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "analyze",
      "cmd": "dart analyze --fatal-infos",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "test",
      "cmd": "dart test",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "help",
      "cmd": "dart run bin/{{ npm_name }}.dart --help",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "usage-error",
      "cmd": "dart run bin/{{ npm_name }}.dart --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "dart"
      ],
      "timeout": 600
    },
    {
      "name": "missing-file",
      "cmd": "dart run bin/{{ npm_name }}.dart does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "dart"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "pubspec.yaml"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
