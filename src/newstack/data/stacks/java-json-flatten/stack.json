{
  "name": "java-json-flatten",
  "title": "Java JSON Flatten",
  "language": "java",
  "blurb": "Jackson-based JSON flattener CLI (dotted keys) with JUnit tests, Maven compiler release 21",
  "requires": [
    "java",
    "mvn",
    "git"
  ],
  "default_description": "A Java CLI that flattens JSON objects into dotted keys.",
  "next_steps": [
    "cd {path}",
    "mvn -B package",
    "java -jar target/{{ npm_name }}.jar input.json"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "mvn -B test",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "package",
      "cmd": "mvn -B package -DskipTests",
      "tools": [
        "mvn",
        "java"
      ],
      "timeout": 1500
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "java",
        "mvn"
      ],
      "timeout": 1800
    }
  ],
  "detect": [
    {
      "file": "pom.xml",
      "contains": "jackson-databind"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "src/test/java/{{ package_name }}/FlattenerTest.java"
  ]
}
