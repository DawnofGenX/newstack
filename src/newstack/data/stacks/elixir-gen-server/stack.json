{
  "name": "elixir-gen-server",
  "title": "Elixir GenServer Queue",
  "language": "elixir",
  "blurb": "OTP application with a bounded work queue GenServer, overflow policies, supervisor, and counters.",
  "requires": ["elixir", "mix"],
  "default_description": "An Elixir OTP work queue.",
  "next_steps": [
    "cd {path}",
    "mix test",
    "mix run -e 'IO.puts(:ok)'"
  ],
  "verify": [
    { "name": "deps", "cmd": "mix deps.get", "tools": ["mix"], "timeout": 300 },
    { "name": "format", "cmd": "mix format --check-formatted", "tools": ["mix"], "timeout": 300 },
    { "name": "test", "cmd": "mix test", "tools": ["mix"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash", "mix"], "timeout": 600 }
  ],
  "detect": [
    { "file": "lib/work_queue/queue.ex", "contains": "overflow" }
  ],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["test/work_queue/queue_test.exs"]
}