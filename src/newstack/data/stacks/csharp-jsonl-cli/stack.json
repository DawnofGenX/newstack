{
  "name": "csharp-jsonl-cli",
  "title": "CSharp JSONL CLI",
  "language": "csharp",
  "blurb": "JSONL filter/aggregate CLI on System.Text.Json only, NO NuGet: --where field=value, --group field --count, deterministic ordering",
  "requires": [
    "dotnet",
    "git"
  ],
  "default_description": "A C# JSONL command line tool.",
  "next_steps": [
    "cd {path}",
    "dotnet build",
    "dotnet test",
    "dotnet run -- data.jsonl --where field=value"
  ],
  "verify": [
    {
      "name": "build",
      "cmd": "dotnet build --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "dotnet test --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 300
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "dotnet"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "Program.cs",
      "contains": "csharp-jsonl-cli"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
