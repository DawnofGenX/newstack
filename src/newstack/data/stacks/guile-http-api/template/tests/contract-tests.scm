;;; The route table, checked without a socket.
(define-module (contract-tests)
  #:use-module (harness)
  #:use-module (textstat contract)
  #:export (run-suite))

(define (body method path query body-text)
  (reply-body (route method path query body-text)))

(define (status method path query body-text)
  (reply-status (route method path query body-text)))

(define (run-suite)
  (check-text "health" (body "GET" "/health" "" "") "{\"status\":\"ok\"}")
  (check-text "get stats" (body "GET" "/stats" "text=hello%20world%0A" "")
              "{\"text\":\"hello world\\n\",\"lines\":1,\"words\":2,\"bytes\":12}")
  (check-equal "get stats status" (status "GET" "/stats" "text=a" "") 200)
  (check-equal "get stats without text" (status "GET" "/stats" "" "") 422)
  (check-text "get stats without text body" (body "GET" "/stats" "" "")
              "{\"error\":\"missing_text\"}")
  (check-equal "get stats empty text" (status "GET" "/stats" "text=" "") 200)
  (check-text "get stats empty text body" (body "GET" "/stats" "text=" "")
              "{\"text\":\"\",\"lines\":0,\"words\":0,\"bytes\":0}")
  (check-text "post stats" (body "POST" "/stats" "" "{\"text\": \"a b\\nc\\n\"}")
              "{\"text\":\"a b\\nc\\n\",\"lines\":2,\"words\":3,\"bytes\":6}")
  (check-equal "post stats status" (status "POST" "/stats" "" "{\"text\": \"x\"}") 200)
  (check-equal "post without text" (status "POST" "/stats" "" "{}") 422)
  (check-text "post without text body" (body "POST" "/stats" "" "{}")
              "{\"error\":\"missing_text\"}")
  (check-equal "post with a number" (status "POST" "/stats" "" "{\"text\": 42}") 422)
  (check-equal "post with broken json" (status "POST" "/stats" "" "nope") 422)
  (check-text "post with broken json body" (body "POST" "/stats" "" "nope")
              "{\"error\":\"invalid_json\"}")
  (check-equal "unknown path" (status "GET" "/nope" "" "") 404)
  (check-text "unknown path body" (body "GET" "/nope" "" "")
              "{\"error\":\"not_found\",\"detail\":\"no route for GET /nope\"}")
  (check-equal "wrong method on health" (status "DELETE" "/health" "" "") 405)
  (check-text "wrong method body" (body "DELETE" "/health" "" "")
              "{\"error\":\"method_not_allowed\"}")
  (check-equal "wrong method on stats" (status "PUT" "/stats" "text=a" "") 405)
  (check-equal "query needs the exact key" (status "GET" "/stats" "note=a" "") 422))
