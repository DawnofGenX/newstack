{
  "name": "django",
  "title": "Django app",
  "language": "python",
  "blurb": "Django 6 JSON API: core app, SQLite, pytest-django, ruff, CI matrix",
  "requires": [
    "uv",
    "git"
  ],
  "default_description": "A Django web application.",
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run python manage.py migrate",
    "uv run python manage.py runserver"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv -q .venv && uv pip install -q --python .venv/bin/python -e . pytest pytest-django ruff",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "check",
      "cmd": ".venv/bin/python manage.py check",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "migrations",
      "cmd": ".venv/bin/python manage.py makemigrations --check --dry-run",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "pytest",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "manage.py"
    },
    {
      "file": "pyproject.toml",
      "contains": "django"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_views.py",
    "tests/test_models.py"
  ]
}
