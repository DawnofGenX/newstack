{
  "name": "sphinx-docs",
  "title": "Sphinx documentation site",
  "language": "python",
  "blurb": "Sphinx docs: autodoc from a src-layout package, doctested examples, warnings-as-errors build",
  "requires": [
    "uv",
    "git"
  ],
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "default_description": "Documentation for a Python package.",
  "next_steps": [
    "cd {path}",
    "uv sync --group dev",
    "uv run sphinx-build -b html docs docs/_build/html",
    "uv run pytest"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv -q --allow-existing .venv && uv pip install -q --python .venv/bin/python -e . pytest ruff 'sphinx>=8.1'",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "build",
      "cmd": ".venv/bin/python -m sphinx -W --keep-going -q -b html docs docs/_build/html",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "doctest",
      "cmd": ".venv/bin/python -m sphinx -q -b doctest docs docs/_build/doctest && grep -q '0 failures' docs/_build/doctest/output.txt",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "ruff",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "docs/conf.py"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_counters.py"
  ]
}
