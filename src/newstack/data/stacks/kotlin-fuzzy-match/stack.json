{
  "name": "kotlin-fuzzy-match",
  "title": "Kotlin Fuzzy Match",
  "language": "kotlin",
  "blurb": "Jaro and Jaro-Winkler similarity with prefix boost, ranked candidate CLI and JUnit5 tests on the published example values",
  "requires": [
    "java",
    "gradle",
    "git"
  ],
  "default_description": "A Kotlin Jaro-Winkler fuzzy matching CLI.",
  "next_steps": [
    "cd {path}",
    "gradle test",
    "gradle run --args='--a MARTHA --b MARHTA'"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "gradle test",
      "tools": [
        "java",
        "gradle"
      ],
      "timeout": 1800
    },
    {
      "name": "pair",
      "cmd": "gradle run --quiet --args='--a MARTHA --b MARHTA' | grep -q 'jaro-winkler=0.9611'",
      "tools": [
        "java",
        "gradle"
      ],
      "timeout": 1800
    },
    {
      "name": "rank",
      "cmd": "gradle run --quiet --args='--a recieve --list receive,relieve' | grep -q '^rank 1: receive'",
      "tools": [
        "java",
        "gradle"
      ],
      "timeout": 1800
    },
    {
      "name": "usage-error",
      "cmd": "gradle run --quiet --args='--nope' >/dev/null 2>&1; test $? -ne 0",
      "tools": [
        "java",
        "gradle"
      ],
      "timeout": 1800
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "java",
        "gradle"
      ],
      "timeout": 1800
    }
  ],
  "detect": [
    {
      "file": "src/**/JaroWinkler.kt",
      "contains": "object JaroWinkler"
    },
    {
      "file": "src/**/JaroWinklerTest.kt",
      "contains": "class JaroWinklerTest"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "src/test/kotlin/{{ package_name }}/JaroWinklerTest.kt"
  ]
}
