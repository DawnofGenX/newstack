{
  "name": "{{ npm_name }}",
  "version": "1.0.0",
  "private": true,
  "description": "A notes API: Prisma + SQLite + Express + TypeScript.",
  "engines": {
    "node": ">={{ node_version }}"
  },
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "test": "npm run build && prisma migrate deploy --schema prisma/schema.prisma && node --test 'dist/tests/**/*.test.js'",
    "contract": "bash smoke.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.19.0",
    "typescript": "^5.6.0"
  }
}
