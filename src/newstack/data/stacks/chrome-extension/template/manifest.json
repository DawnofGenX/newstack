{
  "manifest_version": 3,
  "name": "{{ title }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "{{ title }}"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
