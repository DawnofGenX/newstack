{
  "name": "fortran-stats-cli",
  "title": "Fortran Stats CLI",
  "language": "fortran",
  "blurb": "Fortran stats CLI: mean, median, stdev on stdin, gfortran build, unit tests",
  "requires": [
    "gfortran",
    "make"
  ],
  "default_description": "A Fortran command line tool.",
  "next_steps": [
    "cd {path}",
    "make",
    "make test",
    "./bin/{npm_name} --help"
  ],
  "verify": [
    {
      "name": "build",
      "cmd": "make",
      "tools": [
        "gfortran",
        "make"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "make test",
      "tools": [
        "gfortran",
        "make"
      ],
      "timeout": 300
    },
    {
      "name": "cli",
      "cmd": "./bin/{{ npm_name }} --help >/dev/null 2>&1",
      "timeout": 60
    },
    {
      "name": "usage-error",
      "cmd": "set +e; ./bin/{{ npm_name }} --bogus >/dev/null 2>&1; status=$?; test \"$status\" -eq 2",
      "timeout": 60
    }
  ],
  "detect": [
    {
      "file": "src/stats.f90",
      "contains": "stats_mean"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}