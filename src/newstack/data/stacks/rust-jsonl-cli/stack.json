{
  "name": "rust-jsonl-cli",
  "title": "Rust JSONL CLI",
  "language": "rust",
  "blurb": "Streaming JSONL query CLI in Rust: field select, where filter, count, using a hand-rolled JSON field extractor and integration tests.",
  "requires": ["cargo", "git"],
  "default_description": "A Rust CLI that queries JSONL streams.",
  "next_steps": [
    "cd {path}",
    "cargo run -- -file data.jsonl -select name -where 'age==30'"
  ],
  "verify": [
    { "name": "fmt", "cmd": "cargo fmt --check", "tools": ["cargo"], "timeout": 300 },
    { "name": "clippy", "cmd": "cargo clippy --all-targets -- -D warnings", "tools": ["cargo"], "timeout": 1200 },
    { "name": "test", "cmd": "cargo test", "tools": ["cargo"], "timeout": 1200 },
    { "name": "build", "cmd": "cargo build --release", "tools": ["cargo"], "timeout": 1200 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["cargo"], "timeout": 600 }
  ],
  "detect": [{ "file": "src/lib.rs", "contains": "pub fn query_jsonl" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["tests/cli.rs"]
}