{
  "name": "csharp-hmac-cli",
  "title": "C# HMAC CLI",
  "language": "csharp",
  "blurb": "HMAC sign and verify CLI: SHA-1/256/384/512 and MD5, constant-time comparison, file signing, zero NuGet dependencies",
  "requires": [
    "dotnet"
  ],
  "default_description": "A C# command line tool that signs and verifies HMAC digests.",
  "next_steps": [
    "cd {path}",
    "dotnet test",
    "dotnet run -- sign --key secret --message payload",
    "dotnet run -- verify --key secret --message payload --digest HEX"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "dotnet test --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "dotnet build --nologo",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "dotnet"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "Hmac.cs",
      "contains": "public static class Hmac"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
