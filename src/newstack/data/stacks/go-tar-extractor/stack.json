{
  "name": "go-tar-extractor",
  "title": "Go Tar Extractor",
  "language": "go",
  "blurb": "Safe tar.gz extractor that rejects path traversal and absolute paths, tests for both rejections and a good archive.",
  "requires": ["go", "git"],
  "default_description": "A safe tar.gz extractor.",
  "next_steps": [
    "cd {path}",
    "go build -o bin/tarextract .",
    "./bin/tarextract -in archive.tar.gz -out ./out"
  ],
  "verify": [
    { "name": "vet", "cmd": "go vet ./...", "tools": ["go"], "timeout": 300 },
    { "name": "test", "cmd": "go test ./...", "tools": ["go"], "timeout": 600 },
    { "name": "build", "cmd": "go build -o bin/tarextract .", "tools": ["go"], "timeout": 600 },
    { "name": "smoke", "cmd": "bash smoke.sh", "tools": ["bash"], "timeout": 300 }
  ],
  "detect": [{ "file": "extract.go", "contains": "ExtractArchive" }],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["extract_test.go"]
}