{
  "name": "python-pdf-report",
  "title": "Python PDF report",
  "language": "python",
  "blurb": "A deterministic PDF report of text statistics: reportlab with invariant metadata so the same input gives the same bytes, cp1252 font limits counted instead of hidden, and the PDF read back with pypdf to prove the numbers reached the page",
  "default_description": "A CLI that renders a reproducible PDF report from NDJSON.",
  "python": {
    "minimum": "3.10",
    "versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ]
  },
  "requires": [
    "uv",
    "python3"
  ],
  "next_steps": [
    "cd {path}",
    "uv venv --allow-existing .venv && uv pip install --python .venv/bin/python -e '.[dev]'",
    ".venv/bin/python -m {package_name}.cli --input fixtures/records.ndjson --output report.pdf",
    ".venv/bin/python -m pytest"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e '.[dev]'",
      "tools": [
        "uv"
      ],
      "timeout": 900
    },
    {
      "name": "lint",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": [
        "uv"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "rl_config.invariant"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/test_report.py"
  ]
}
