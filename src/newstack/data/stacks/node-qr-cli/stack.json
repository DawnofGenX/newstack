{
  "name": "node-qr-cli",
  "title": "Node QR CLI",
  "language": "node",
  "blurb": "CLI that renders QR codes (dep: qrcode) to a PNG and a terminal renderer; tests assert PNG magic bytes and size",
  "requires": [
    "node",
    "npm"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A CLI that renders QR codes with qrcode.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "node src/cli.js --text 'hello' --output /tmp/qr.png",
    "node src/cli.js --text 'hello'"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "package.json",
      "contains": "qrcode"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/qr.test.js"
  ]
}