{
  "name": "go-cron-cli",
  "title": "Go Cron CLI",
  "language": "go",
  "blurb": "Five-field cron parser that prints upcoming fire times; table-based matching, UTC math.",
  "requires": [
    "go",
    "git"
  ],
  "default_description": "A cron expression parser that prints the next fire times.",
  "next_steps": [
    "cd {path}",
    "go run . -spec '*/15 * * * *' -count 4"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": [
        "go"
      ],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/{{ npm_name }} .",
      "tools": [
        "go"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "go"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "cron.go",
      "contains": "type Schedule struct"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "cron_test.go"
  ]
}
