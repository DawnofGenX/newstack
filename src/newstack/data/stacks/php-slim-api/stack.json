{
  "name": "php-slim-api",
  "title": "PHP Slim API",
  "language": "php",
  "blurb": "Slim 4 API with a JSON endpoint, PHPUnit test, composer.json",
  "requires": [
    "php",
    "composer",
    "git"
  ],
  "default_description": "A PHP Slim API.",
  "port": 5577,
  "next_steps": [
    "cd {path}",
    "composer install",
    "php -S 127.0.0.1:5577 -t public public/index.php"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "composer install --no-interaction --prefer-dist && vendor/bin/phpunit",
      "tools": [
        "composer",
        "php"
      ],
      "timeout": 900
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "php",
        "composer",
        "curl"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "composer.json",
      "contains": "slim/slim"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/ApiTest.php"
  ]
}
