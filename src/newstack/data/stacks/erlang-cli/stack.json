{
  "name": "erlang-cli",
  "title": "Erlang CLI",
  "language": "erlang",
  "blurb": "Erlang CLI on plain OTP and make: byte-counting core, hand-written argv parser, eunit suites, IO behind a map of funs",
  "requires": [
    "erl",
    "erlc",
    "make"
  ],
  "default_description": "An Erlang command line tool.",
  "next_steps": [
    "cd {path}",
    "make",
    "make test",
    "./bin/{npm_name} --help"
  ],
  "verify": [
    {
      "name": "compile",
      "cmd": "make -s",
      "tools": [
        "erl",
        "erlc",
        "make"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "make -s test",
      "tools": [
        "erl",
        "erlc",
        "make"
      ],
      "timeout": 900
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "erl",
        "erlc",
        "make"
      ],
      "timeout": 600
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "erl",
        "erlc",
        "make"
      ],
      "timeout": 600
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "erl",
        "erlc",
        "make"
      ],
      "timeout": 600
    },
    {
      "name": "stdin",
      "cmd": "test \"$(printf 'alpha beta\\ngamma\\n' | ./bin/{{ npm_name }} -w)\" = '3 -'",
      "tools": [
        "erl",
        "erlc",
        "make"
      ],
      "timeout": 600
    },
    {
      "name": "parity",
      "cmd": "printf 'alpha beta\\ngamma delta\\n' > .p1.txt && printf 'no trailing newline' > .p2.txt && printf 'h\\303\\251llo w\\303\\266rld\\n' > .p3.txt && : > .p4.txt && printf 'a\\tb\\nc\\vd\\re\\n' > .p5.txt && for f in .p1.txt .p2.txt .p3.txt .p4.txt .p5.txt; do ours=$(./bin/{{ npm_name }} -l -w -c \"$f\" | awk '{print $1, $2, $3}'); theirs=$(wc -l -w -c \"$f\" | awk '{print $1, $2, $3}'); if [ \"$ours\" != \"$theirs\" ]; then echo \"MISMATCH $f: ours=[$ours] theirs=[$theirs]\"; exit 1; fi; done && rm -f .p1.txt .p2.txt .p3.txt .p4.txt .p5.txt && echo \"parity ok\"",
      "tools": [
        "erl",
        "erlc",
        "make",
        "wc"
      ],
      "timeout": 900
    }
  ],
  "detect": [
    {
      "file": "Makefile",
      "contains": "erlc"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
