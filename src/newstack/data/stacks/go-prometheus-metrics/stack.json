{
  "name": "go-prometheus-metrics",
  "title": "Go Prometheus Metrics",
  "language": "go",
  "blurb": "Service exposing Prometheus text exposition with counter and histogram",
  "default_description": "A Go service with Prometheus metrics.",
  "port": 5543,
  "requires": ["go", "git"],
  "next_steps": [
    "cd {path}",
    "go run .",
    "curl -sS http://127.0.0.1:5543/metrics"
  ],
  "verify": [
    {
      "name": "vet",
      "cmd": "go vet ./...",
      "tools": ["go"],
      "timeout": 300
    },
    {
      "name": "test",
      "cmd": "go test ./...",
      "tools": ["go"],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "go build -o bin/server .",
      "tools": ["go"],
      "timeout": 600
    },
    {
      "name": "http",
      "cmd": "bash smoke.sh",
      "tools": ["bash", "curl"],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "main.go",
      "contains": "promhttp.Handler"
    }
  ],
  "detect_fallback": false,
  "adopt": [".github/workflows/ci.yml", ".gitignore"],
  "adopt_tests": ["main_test.go"]
}
