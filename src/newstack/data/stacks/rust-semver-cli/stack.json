{
  "name": "rust-semver-cli",
  "title": "Rust Semver CLI",
  "language": "rust",
  "blurb": "Semver parse/compare/bump CLI with table-driven tests",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust CLI for parsing, comparing, and bumping semantic versions.",
  "next_steps": [
    "cd {path}",
    "cargo run -- parse 1.2.3"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "Cargo.toml",
      "contains": "semver"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/cli.rs"
  ]
}
