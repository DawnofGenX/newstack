{
  "name": "rust-ring-buffer",
  "title": "Rust Ring Buffer",
  "language": "rust",
  "blurb": "Generic fixed-capacity ring buffer with overwrite-on-full, push/pop/front/back and unit tests",
  "requires": [
    "cargo",
    "git"
  ],
  "default_description": "A Rust library implementing a ring buffer.",
  "next_steps": [
    "cd {path}",
    "cargo test"
  ],
  "verify": [
    {
      "name": "fmt",
      "cmd": "cargo fmt --check",
      "tools": [
        "cargo"
      ],
      "timeout": 300
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --all-targets -- -D warnings",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "cargo test",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "build",
      "cmd": "cargo build --release",
      "tools": [
        "cargo"
      ],
      "timeout": 1200
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "cargo"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "src/lib.rs",
      "contains": "RingBuffer"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ]
}
