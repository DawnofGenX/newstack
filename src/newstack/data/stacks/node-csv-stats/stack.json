{
  "name": "node-csv-stats",
  "title": "Node CSV Stats",
  "language": "node",
  "blurb": "RFC 4180 CSV parser plus per column profiling: empty counts, distinct values, numeric min/max/mean.",
  "requires": [
    "node",
    "npm"
  ],
  "node": {
    "minimum": "22",
    "versions": [
      "22",
      "24"
    ]
  },
  "package_manager": [
    "npm",
    "pnpm",
    "yarn"
  ],
  "default_description": "A CSV profiler with an RFC 4180 parser and per column statistics.",
  "next_steps": [
    "cd {path}",
    "{package_manager_install}",
    "{package_manager_test}",
    "node src/cli.js --file data.csv --table"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "npm install --no-audit --no-fund",
      "tools": [
        "npm"
      ],
      "timeout": 900
    },
    {
      "name": "test",
      "cmd": "npm test",
      "tools": [
        "npm"
      ],
      "timeout": 600
    },
    {
      "name": "smoke",
      "cmd": "bash smoke.sh",
      "tools": [
        "bash",
        "node"
      ],
      "timeout": 300
    }
  ],
  "detect": [
    {
      "file": "src/csv.js",
      "contains": "export function parseCsv"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": [
    "tests/csv.test.js"
  ]
}
