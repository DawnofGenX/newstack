{
  "name": "crystal-hex-cli",
  "title": "Crystal Hex CLI",
  "language": "crystal",
  "blurb": "Crystal 1.11+ CLI: hex dump and reverse (xxd -r style), offset and width flags",
  "requires": [
    "crystal"
  ],
  "default_description": "A Crystal command line tool.",
  "next_steps": [
    "cd {path}",
    "crystal spec",
    "mkdir -p bin && crystal build -o bin/{npm_name} src/hex.cr",
    "bin/{npm_name} --help"
  ],
  "verify": [
    {
      "name": "test",
      "cmd": "crystal spec",
      "tools": [
        "crystal"
      ],
      "timeout": 600
    },
    {
      "name": "build",
      "cmd": "mkdir -p bin && crystal build -o bin/{{ npm_name }} src/hex.cr",
      "tools": [
        "crystal"
      ],
      "timeout": 600
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    },
    {
      "name": "stdin",
      "cmd": "printf 'AB' | ./bin/{{ npm_name }}",
      "tools": [
        "crystal"
      ],
      "timeout": 120
    }
  ],
  "detect": [
    {
      "file": "src/hex/dump.cr",
      "contains": "crystal-hex-cli"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}