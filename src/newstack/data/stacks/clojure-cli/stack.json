{
  "name": "clojure-cli",
  "title": "Clojure CLI",
  "language": "clojure",
  "blurb": "Clojure CLI on deps.edn: pure counting core, hand-rolled argv parser, clojure.test suites, no Leiningen",
  "requires": [
    "clojure",
    "java"
  ],
  "default_description": "A Clojure command line tool.",
  "next_steps": [
    "cd {path}",
    "clojure -M -e \"(require 'textstat.cli)\"",
    "clojure -M:test -m textstat.run-tests",
    "./bin/{npm_name} --help"
  ],
  "verify": [
    {
      "name": "compile",
      "cmd": "clojure -M -e \"(require 'textstat.cli)\"",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 1800
    },
    {
      "name": "test",
      "cmd": "clojure -M:test -m textstat.run-tests",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 1800
    },
    {
      "name": "help",
      "cmd": "./bin/{{ npm_name }} --help",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    },
    {
      "name": "usage-error",
      "cmd": "./bin/{{ npm_name }} --bogus >/dev/null 2>&1; test $? -eq 2",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    },
    {
      "name": "missing-file",
      "cmd": "./bin/{{ npm_name }} does-not-exist.txt >/dev/null 2>&1; test $? -eq 1",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    },
    {
      "name": "stdin",
      "cmd": "test \"$(printf 'alpha beta\\ngamma\\n' | ./bin/{{ npm_name }} -w)\" = '3 -'",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    },
    {
      "name": "parity",
      "cmd": "printf 'alpha beta\\ngamma delta\\n' > .p1.txt && printf 'no trailing newline' > .p2.txt && printf 'h\\303\\251llo w\\303\\266rld\\n' > .p3.txt && : > .p4.txt && printf 'a\\tb\\nc\\vd\\re\\n' > .p5.txt && for f in .p1.txt .p2.txt .p3.txt .p4.txt .p5.txt; do ours=$(./bin/{{ npm_name }} -l -w -c \"$f\" | awk '{print $1, $2, $3}'); theirs=$(wc -l -w -c \"$f\" | awk '{print $1, $2, $3}'); if [ \"$ours\" != \"$theirs\" ]; then echo \"MISMATCH $f: ours=[$ours] theirs=[$theirs]\"; exit 1; fi; done && rm -f .p1.txt .p2.txt .p3.txt .p4.txt .p5.txt && echo \"parity ok\"",
      "tools": [
        "clojure",
        "java"
      ],
      "timeout": 600
    }
  ],
  "detect": [
    {
      "file": "deps.edn"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".github/workflows/ci.yml",
    ".gitignore"
  ],
  "adopt_tests": []
}
