{
  "name": "python-b-tree",
  "title": "Balanced Keys",
  "language": "python",
  "blurb": "A keyed B-tree of configurable order: insert with splits, delete with borrow and merge, exact lookup and range scan, and a page file that reads back identical after any history.",
  "requires": ["uv", "python3"],
  "default_description": "A keyed B-tree that keeps its band under insert and delete histories and proves the freeze with a page file round trip.",
  "python": {
    "minimum": "3.12",
    "versions": ["3.12", "3.13"]
  },
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run {npm_name} load --keys fixtures/keys.txt --order 2",
    "uv run {npm_name} page --keys fixtures/keys.txt --out tree.page",
    "PY=.venv/bin/python bash smoke.sh"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --python 3.12 --allow-existing && uv pip install --python .venv/bin/python -e . pytest ruff",
      "tools": ["uv"],
      "timeout": 300
    },
    {
      "name": "lint",
      "cmd": ".venv/bin/ruff check .",
      "tools": ["uv"],
      "timeout": 120
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": ["uv"],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} selftest",
      "tools": ["uv"],
      "timeout": 120
    },
    {
      "name": "smoke",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": ["bash"],
      "timeout": 180
    }
  ],
  "detect": [
    { "file": "**/*.py", "contains": "never goes jagged" }
  ],
  "detect_fallback": false,
  "adopt": [".gitignore", ".github/workflows/ci.yml"],
  "adopt_tests": ["tests/test_btree.py"]
}
