{
  "name": "python-splay-tree",
  "title": "Splay Tree",
  "language": "python",
  "blurb": "A self-adjusting BST over integer keys: the walk equals sorted(live) on mixed insert storms, the touched key sits at the root after every access, and zig, zig-zig, and zig-zag preserve the in-order walk.",
  "default_description": "A self-adjusting BST over integer keys whose last-touched key sits at the root after every access.",
  "requires": [
    "uv",
    "python3"
  ],
  "python": {
    "minimum": "3.12",
    "versions": [
      "3.12",
      "3.13"
    ]
  },
  "next_steps": [
    "cd {path}",
    "uv sync",
    "uv run {npm_name} iter --keys fixtures/keys.txt",
    "uv run {npm_name} has --keys fixtures/keys.txt 42",
    "uv run {npm_name} max --keys fixtures/keys.txt",
    "PY=.venv/bin/python bash smoke.sh"
  ],
  "verify": [
    {
      "name": "install",
      "cmd": "uv venv --python 3.12 --allow-existing && uv pip install --python .venv/bin/python -e . pytest ruff",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "lint",
      "cmd": ".venv/bin/ruff check .",
      "tools": [
        "uv"
      ],
      "timeout": 120
    },
    {
      "name": "test",
      "cmd": ".venv/bin/python -m pytest -q",
      "tools": [
        "uv"
      ],
      "timeout": 300
    },
    {
      "name": "selftest",
      "cmd": ".venv/bin/python -m {{ package_name }} selftest",
      "tools": [
        "uv"
      ],
      "timeout": 120
    },
    {
      "name": "smoke",
      "cmd": "PY=.venv/bin/python bash smoke.sh",
      "tools": [
        "bash"
      ],
      "timeout": 180
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "a splay hands the root over"
    }
  ],
  "detect_fallback": false,
  "adopt": [
    ".gitignore",
    ".github/workflows/ci.yml"
  ],
  "adopt_tests": [
    "tests/test_tree.py"
  ]
}
